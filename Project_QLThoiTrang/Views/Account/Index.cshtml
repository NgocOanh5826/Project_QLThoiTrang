@model ProfileInput
@{ViewData["Title"]="Tài khoản của tôi";}
<section class="page-section"><div class="page-heading"><div><p class="eyebrow">KHÔNG GIAN CỦA BẠN</p><h1>Xin chào, @Model.Name</h1></div><form asp-action="Logout" method="post"><button class="button-secondary">Đăng xuất</button></form></div><div class="checkout-grid"><form asp-action="Index" method="post" class="panel form-stack"><h2>Thông tin cá nhân</h2><div asp-validation-summary="All" class="validation"></div><label>Họ tên<input asp-for="Name"/></label><label>Email<input value="@ViewBag.Email" disabled/></label><label>Số điện thoại<input asp-for="Phone"/></label><label>Địa chỉ<textarea asp-for="Address"></textarea></label><button class="btn-black">Lưu thay đổi</button></form><aside class="panel form-stack"><h2>Truy cập nhanh</h2><a href="/Account/Orders" class="button-secondary">Đơn hàng của tôi</a><a href="/Shop/Wishlist" class="button-secondary">Sản phẩm yêu thích</a><a href="/Shop/Cart" class="button-secondary">Giỏ hàng</a>@if(User.IsInRole("Admin")){<a href="/Admin" class="btn-black">Quản trị cửa hàng</a>}<a href="/Home/Info/contact" class="text-link">Cần hỗ trợ?</a></aside></div></section>

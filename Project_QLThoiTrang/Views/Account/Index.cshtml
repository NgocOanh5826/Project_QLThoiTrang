@model ProfileInput
@{ViewData["Title"]="Tài khoản của tôi";}
<section class="page-section"><div class="page-heading"><div><p class="eyebrow">KHÔNG GIAN CỦA BẠN</p><h1>Xin chào, @Model.Name</h1></div><form asp-action="Logout" method="post"><button class="button-secondary">Đăng xuất</button></form></div><div class="checkout-grid"><form asp-action="Index" method="post" class="panel form-stack"><h2>Thông tin cá nhân</h2><div asp-validation-summary="All" class="validation"></div><label>Họ tên<input asp-for="Name"/></label><label>Email<input value="@ViewBag.Email" disabled/></label><label>Số điện thoại<input asp-for="Phone"/></label><div class="address-picker" data-address-picker><input asp-for="Address" type="hidden" data-address-full/><div class="form-grid address-grid"><label>Tỉnh/Thành phố<select data-address-province required><option value="">Chọn tỉnh/thành phố</option></select></label><label>Xã/Phường<select data-address-ward required disabled><option value="">Chọn xã/phường</option></select></label></div><label>Số nhà, tên đường<input type="text" data-address-street placeholder="Ví dụ: 96 Võ Văn Ngân" autocomplete="street-address" required/></label></div><button class="btn-black">Lưu thay đổi</button></form><aside class="panel quick-panel"><h2>Truy cập nhanh</h2><nav class="quick-links" aria-label="Truy cập tài khoản"><a href="/Account/Orders" class="button-secondary">Đơn hàng của tôi</a><a href="/Shop/Wishlist" class="button-secondary">Sản phẩm yêu thích</a><a href="/Shop/Cart" class="button-secondary">Giỏ hàng</a>@if(User.IsInRole("Admin")){<a href="/Admin" class="btn-black">Quản trị cửa hàng</a>}<a href="/Home/Info/contact" class="text-link">Cần hỗ trợ?</a></nav></aside></div></section>

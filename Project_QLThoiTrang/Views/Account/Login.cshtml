@*
    VAI TRÒ VIEW: Mở form đăng nhập; chỉ giữ returnUrl nội bộ để tránh chuyển hướng ra trang bên
    ngoài. DỮ LIỆU MODEL: LoginInput. ĐIỂM XỬ LÝ: Controllers/AccountController.cs; tra
    HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model LoginInput
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="auth-grid auth-login">
    <aside class="auth-story">
        <a href="/" class="auth-brand">
            QOANH
            <span>EVERYDAY, YOUR WAY</span>
        </a>
        <div class="auth-story-copy">
            <p class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</p>
            <h1>
                Phong cách
                <br/>
                riêng của bạn
                <br/>
                đang chờ.
            </h1>
            <p>Tiếp tục khám phá những món đồ bạn yêu thích và theo dõi đơn hàng của mình.</p>
        </div>
        <a href="/Shop" class="auth-backlink">← Khám phá cửa hàng</a>
        <span class="auth-note">BẢN DEMO · KHÔNG THANH TOÁN THẬT</span>
    </aside>
    <div class="auth-form-wrap">
        <a href="/" class="auth-mobile-brand">
            QOANH
            <span>EVERYDAY, YOUR WAY</span>
        </a>
        @*
            FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Account/Login.
            asp-for liên kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra
            ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo
            token chống CSRF khi áp dụng. CHỨC NĂNG: Kiểm tra email/mẫu nhập và xác thực mật khẩu
            bằng StoreService.Authenticate; thành công tạo cookie, gộp giỏ và chuyển tới returnUrl
            hoặc trang theo vai trò. Policy login giới hạn số lần yêu cầu.
        *@
        <form asp-action="Login" method="post" class="auth-form">
            <input asp-for="ReturnUrl" type="hidden"/>
            <span class="auth-step">
                KHÔNG GIAN CỦA BẠN
                <span>01 / 02</span>
            </span>
            <h2>Đăng nhập</h2>
            <p class="auth-intro">Nhập thông tin để tiếp tục.</p>
            @*
                THÔNG BÁO LỖI: Razor hiển thị các lỗi ModelState do binding, DataAnnotations hoặc
                controller thêm; sửa ô bị lỗi rồi gửi lại form.
            *@
            <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
            <label asp-for="Email">Địa chỉ email</label>
            <div class="auth-input-wrap">
                <i class="bi bi-envelope" aria-hidden="true"></i>
                <input
                    asp-for="Email"
                    type="email"
                    autocomplete="username"
                    placeholder="ten@email.com"
                    inputmode="email"
                    autocapitalize="none"
                    aria-describedby="Email-error"
                />
            </div>
            <span asp-validation-for="Email" id="Email-error" class="field-error" role="alert"></span>
            <div class="auth-label-row">
                <label asp-for="Password">Mật khẩu</label>
                <span>Ít nhất 8 ký tự</span>
            </div>
            <div class="auth-input-wrap">
                <i class="bi bi-lock" aria-hidden="true"></i>
                <input
                    asp-for="Password"
                    type="password"
                    autocomplete="current-password"
                    placeholder="Nhập mật khẩu"
                    aria-describedby="Password-error"
                />
                <button
                    class="password-toggle"
                    type="button"
                    data-password-toggle="Password"
                    aria-label="Hiện mật khẩu"
                    aria-pressed="false"
                >
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span
                asp-validation-for="Password"
                id="Password-error"
                class="field-error"
                role="alert"
            ></span>
            <div class="auth-options">
                <label class="remember-check">
                    <input asp-for="RememberMe"/>
                    <span>Duy trì đăng nhập</span>
                </label>
                <a href="/Recovery/Forgot">Quên mật khẩu?</a>
            </div>
            <button type="submit" class="auth-submit">
                Đăng nhập
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
            <p class="auth-switch">
                Chưa có tài khoản?
                <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Tạo tài khoản</a>
            </p>
            <details class="demo-accounts">
                <summary>
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    Tài khoản dùng thử trên máy này
                </summary>
                <div>
                    <p>
                        Khách hàng
                        <code>khach@qoanh.local</code>
                    </p>
                    <p>
                        Mật khẩu
                        <code>Khach@12345</code>
                    </p>
                    <p>
                        Quản trị
                        <code>admin@qoanh.local</code>
                    </p>
                    <p>
                        Mật khẩu
                        <code>Admin@12345</code>
                    </p>
                    <small>Tài khoản chỉ dùng cho dữ liệu demo cục bộ.</small>
                </div>
            </details>
        </form>
    </div>
</section>

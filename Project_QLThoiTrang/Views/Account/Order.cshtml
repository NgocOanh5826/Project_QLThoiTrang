@*
    VAI TRÒ VIEW: Mở đơn và yêu cầu trả hàng thuộc đúng tài khoản đang đăng nhập; không được xem đơn
    chỉ bằng cách đoán mã của khách khác. DỮ LIỆU MODEL: Order. ĐIỂM XỬ LÝ:
    Controllers/AccountController.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model Order
@{
    ViewData["Title"] = "Đơn hàng " + Model.Id;
}
<section class="page-section">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ĐƠN HÀNG CỦA BẠN</p>
            <h1>@Model.Id</h1>
            <p class="muted">
                @Model.Created.ToString("dd/MM/yyyy HH:mm")
                ·
                <span class="status">@Model.Status</span>
            </p>
        </div>
        <a href="/Account/Orders" class="button-secondary">Tất cả đơn hàng</a>
    </div>
    <div class="checkout-grid">
        <div class="panel">
            <h2>Sản phẩm trong đơn</h2>
            @*
                THÀNH PHẦN DÙNG CHUNG: Views/Shared/_OrderLines.cshtml. Bảng chi tiết sản phẩm trong
                đơn, gồm biến thể, giá và lượng; giá là ảnh chụp lúc đặt, không phải ô sửa giá bán.
            *@
            <partial name="_OrderLines" model="Model"/>
        </div>
        <aside class="panel form-stack">
            <h2>Giao đến</h2>
            <p>
                @Model.Name
                <br/>
                @Model.Phone
                <br/>
                @Model.Address
            </p>
            <p>@Model.Note</p>
            <p class="muted">@Model.Payment</p>
            @if (Model.Status == "Chờ xác nhận")
            {
                @*
                    FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới
                    /Account/Cancel. Controller nhận dữ liệu và kiểm tra ModelState/quyền; service
                    kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token chống CSRF khi
                    áp dụng. CHỨC NĂNG: Gửi yêu cầu hủy đơn của khách tới ChangeOrderStatus với
                    customer = true; service chỉ chấp nhận đơn của mình còn Chờ xác nhận.Các thuộc
                    tính data-* nối form với sự kiện JavaScript trong wwwroot/js.
                *@
                <form asp-action="Cancel" method="post" data-confirm="Hủy đơn hàng này?">
                    <input type="hidden" name="id" value="@Model.Id"/>
                    <button class="button-danger">Hủy đơn hàng</button>
                </form>
            }
            <a href="/Home/Info/contact" class="text-link">Liên hệ hỗ trợ</a>
        </aside>
    </div>
</section>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_PaymentStatus.cshtml. Hiển thị trạng thái tiền đã thu/hoàn
    và hướng dẫn liên quan; Admin/Payment mới là điểm nhận thao tác ghi nhận thu tiền.
*@
<partial name="_PaymentStatus" model="Model"/>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_ReturnRequest.cshtml. Hiển thị thông tin và dòng của phiếu
    trả; Account/Return tạo yêu cầu, Admin/ResolveReturn xử lý duyệt/từ chối.
*@
<partial name="_ReturnRequest" model="Model"/>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_OrderHistory.cshtml. Hiển thị các mốc lịch sử trạng thái
    đơn được Load từ SQL; thao tác đổi trạng thái xử lý ở Admin/OrderStatus.
*@
<partial name="_OrderHistory" model="Model"/>
<div class="actions toolbar-actions">
    <a href="/Documents/Order/@Model.Id" class="button-secondary">Tải PDF đơn hàng</a>
</div>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_ShipmentStatus.cshtml. Hiển thị vận đơn hiện có và liên kết
    quản lý giao hàng; ShippingController nhận lệnh tạo/đồng bộ GHN.
*@
<partial name="_ShipmentStatus" model="Model"/>

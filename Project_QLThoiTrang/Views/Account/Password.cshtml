@model PasswordInput
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<link rel="stylesheet" href="~/css/password-recovery.css" asp-append-version="true" />
<section class="page-section recovery-page">
    <a href="/Account" class="recovery-back">← Quay lại tài khoản</a>
    <div class="panel recovery-card">
        <p class="eyebrow">BẢO MẬT TÀI KHOẢN</p>
        <h1>Đổi mật khẩu</h1>
        <p class="muted">Xác minh mật khẩu hiện tại trước khi đặt mật khẩu mới cho tài khoản.</p>

        <form asp-action="Password" method="post" class="form-stack" data-password-validation>
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
            <div class="auth-input-wrap">
                <i class="bi bi-lock" aria-hidden="true"></i>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                <button type="button" class="password-toggle" data-password-toggle="CurrentPassword"
                        aria-label="Hiện mật khẩu" aria-pressed="false">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
            <label asp-for="NewPassword">Mật khẩu mới</label>
            <div class="auth-input-wrap">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                <input asp-for="NewPassword" type="password" autocomplete="new-password"
                       minlength="8" maxlength="100" required aria-describedby="password-help" />
                <button type="button" class="password-toggle" data-password-toggle="NewPassword"
                        aria-label="Hiện mật khẩu" aria-pressed="false">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="field-error"></span>
            <p id="password-help" class="muted small">8–100 ký tự, có chữ và số; khác mật khẩu hiện tại.</p>
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                   minlength="8" maxlength="100" required />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            <button type="submit" class="btn-black">Lưu mật khẩu mới</button>
        </form>
        <p class="recovery-footer">Không nhớ mật khẩu hiện tại? <a href="/Recovery/Forgot">Lấy lại mật khẩu</a></p>
        <p class="muted small">Đổi thành công, bạn cần đăng nhập lại bằng mật khẩu mới.</p>
    </div>
</section>
<script src="~/js/password-recovery.js" asp-append-version="true"></script>

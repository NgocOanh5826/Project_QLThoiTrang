@*
    VAI TRÒ VIEW: Mở danh sách danh mục và dữ liệu liên quan để kiểm tra danh mục đang được sản phẩm
    sử dụng. DỮ LIỆU MODEL: StoreData. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model StoreData
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    ViewData["CreateUrl"] = "/Admin/Category";
    ViewData["CreateLabel"] = "Thêm danh mục";
}
@{
    ViewData["TableFilters"] = new[]
    {
        AdminListFilter.Choice("usage", "Sử dụng", ("used", "Đã có sản phẩm"), ("unused",
    "Chưa có sản phẩm"))
    };
}
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_AdminListToolbar.cshtml. Thanh tìm kiếm/lọc danh sách quản
    trị dùng lại qua partial; thuộc tính data-* kết nối với bộ xử lý lọc trong wwwroot/js/site.js.
*@
<partial name="_AdminListToolbar"/>
<div class="panel table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Danh mục</th>
                <th>Sản phẩm</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr
                    data-filter-usage="@(Model.Products.Any(p => p.Category == category) ? "used"
                    : "unused")"
                >
                    <td>
                        <strong>@category</strong>
                    </td>
                    <td>@Model.Products.Count(p => p.Category == category)</td>
                    <td class="table-actions-cell">
                        <div class="table-actions">
                            @*
                                FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới
                                /Admin/DeleteCategory. Controller nhận dữ liệu và kiểm tra
                                ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu.
                                TagHelper form POST tạo token chống CSRF khi áp dụng. CHỨC NĂNG: Xóa
                                danh mục bằng POST; nếu có bất kỳ sản phẩm nào đang thuộc danh mục
                                thì báo lỗi và giữ lại, ngược lại Remove khỏi d.Categories để
                                PersistNative đồng bộ.Các thuộc tính data-* nối form với sự kiện
                                JavaScript trong wwwroot/js.
                            *@
                            <form
                                asp-action="DeleteCategory"
                                method="post"
                                data-confirm="Xóa danh mục trống này?"
                            >
                                <input type="hidden" name="name" value="@category"/>
                                <button
                                    class="button-danger compact table-action table-action--danger"
                                    disabled="@(Model.Products.Any(p => p.Category == category))"
                                >Xóa danh mục</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

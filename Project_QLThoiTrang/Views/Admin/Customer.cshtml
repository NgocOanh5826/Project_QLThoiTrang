@*
    VAI TRÒ VIEW: Hiển thị thông tin một tài khoản và danh sách đơn của tài khoản đó; id không tồn
    tại trả 404. DỮ LIỆU MODEL: Customer. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model Customer
@{
    ViewData["Title"] = "Hồ sơ khách hàng";
    var orders = (List<Order>)ViewBag.Orders;
}
<div class="panel form-stack">
    <h2>@Model.Name</h2>
    <p>@Model.Email · @Model.Phone</p>
    <p>@Model.Address</p>
    <div class="actions">
        <span class="status">@orders.Count đơn hàng</span>
        <span class="status">
            Đã giao: @orders.Where(o => o.Status == "Đã giao").Sum(o => o.Total).ToString("N0") đ
        </span>
    </div>
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày</th>
                    <th>Trạng thái</th>
                    <th>Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in orders)
                {
                    <tr>
                        <td>
                            <a asp-action="Order" asp-route-id="@o.Id" class="underlined">@o.Id</a>
                        </td>
                        <td>@o.Created.ToString("dd/MM/yyyy")</td>
                        <td>@o.Status</td>
                        <td>@o.Total.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a href="/Admin/Customers" class="button-secondary">Quay lại danh sách</a>
</div>
<a class="button-secondary" href="/Admin/EditCustomer/@Model.Id">Chỉnh sửa / khóa tài khoản</a>

@model List<Customer>
@{ViewData["Title"]="Khách hàng";}
<form method="get" class="filter-bar admin-list-toolbar" data-admin-server-filter><label class="admin-list-search">Tìm khách hàng<input name="q" value="@ViewBag.Query" placeholder="Họ tên, email hoặc điện thoại"/></label><label>Trạng thái<select name="state"><option value="">Tất cả</option><option value="active" selected="@(ViewBag.State=="active")">Đang hoạt động</option><option value="inactive" selected="@(ViewBag.State=="inactive")">Đã khóa</option></select></label><label>Đơn hàng<select name="hasOrders"><option value="">Tất cả</option><option value="yes" selected="@(ViewBag.HasOrders=="yes")">Đã có đơn</option><option value="no" selected="@(ViewBag.HasOrders=="no")">Chưa có đơn</option></select></label><button class="button-secondary">Lọc</button><a href="/Admin/Customers" class="button-secondary">Xóa bộ lọc</a><span class="muted small admin-filter-count">@Model.Count / @ViewBag.Total bản ghi</span></form>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Khách hàng</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Email</td><td>@c.Phone</td><td><span class="status">@(c.Active?"Đang hoạt động":"Đã khóa")</span></td><td class="table-actions-cell"><div class="table-actions"><a asp-action="Customer" asp-route-id="@c.Id" class="button-secondary compact table-action">Chi tiết</a></div></td></tr>}</tbody></table>@if(Model.Count==0){<p class="empty-state">Không tìm thấy khách hàng.</p>}</div>

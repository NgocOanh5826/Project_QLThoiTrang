@*
    VAI TRÒ VIEW: Trang tổng quan quản trị; lấy StoreData để view tổng hợp sản phẩm, đơn, khách và
    tồn. DỮ LIỆU MODEL: StoreData. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và AdminExtensions.cs;
    tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model StoreData
@{
    ViewData["Title"] = "Tổng quan";
    var revenue = Model.Orders.Where(o => (o.Status == "Đã giao" || o.Status == "Hoàn thành")).Sum(
    o => o.NetMerchandiseRevenue);
}
<div class="admin-welcome">
    <div>
        <p class="eyebrow">MỘT NGÀY KINH DOANH RÕ RÀNG HƠN</p>
        <h2>Chào mừng trở lại.</h2>
        <p>Theo dõi sản phẩm, đơn hàng và những việc cần xử lý.</p>
    </div>
    <a href="/Admin/Product" class="btn-black">Thêm sản phẩm</a>
</div>
<div class="metrics">
    <div class="metric">
        <span>Doanh thu hàng đã giao</span>
        <strong>@revenue.ToString("N0") đ</strong>
        <small>Chưa bao gồm phí vận chuyển</small>
    </div>
    <div class="metric">
        <span>Đơn chờ xác nhận</span>
        <strong>@Model.Orders.Count(o => o.Status == "Chờ xác nhận")</strong>
        <small>Cần xử lý</small>
    </div>
    <div class="metric">
        <span>Sản phẩm đang bán</span>
        <strong>@Model.Products.Count(p => p.Active)</strong>
        <small>Trong danh mục cửa hàng</small>
    </div>
    <div class="metric">
        <span>Sắp hết hàng</span>
        <strong>@Model.Products.Count(p => p.Active && p.Stock <= 5)</strong>
        <small>Tồn kho ≤ 5 sản phẩm</small>
    </div>
</div>
<div class="panel">
    <div class="section-title">
        <h2>Đơn hàng gần đây</h2>
        <a href="/Admin/Orders">Xem tất cả →</a>
    </div>
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày</th>
                    <th>Trạng thái</th>
                    <th>Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders.OrderByDescending(o => o.Created).Take(6))
                {
                    <tr>
                        <td>
                            <a asp-action="Order" asp-route-id="@o.Id" class="underlined">@o.Id</a>
                        </td>
                        <td>@o.Name</td>
                        <td>@o.Created.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status">@o.Status</span>
                        </td>
                        <td>@o.Total.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Orders.Count == 0)
    {
        <p class="empty-state">Chưa có đơn hàng.</p>
    }
</div>

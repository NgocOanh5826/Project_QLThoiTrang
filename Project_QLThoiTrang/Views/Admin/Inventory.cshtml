@model List<Product>
@{ViewData["Title"]="Quản lý tồn kho";}
<p class="notice">Tồn kho tổng theo sản phẩm; đơn đặt hàng trừ kho, đơn hủy hoàn lại kho. Chưa tách tồn theo kích cỡ trong demo.</p><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Hiện có</th><th>Tình trạng</th><th>Điều chỉnh tồn thực tế</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><div class="table-product"><img src="@p.Image" alt=""/><strong>@p.Name</strong></div></td><td>@p.Stock</td><td><span class="status @(p.Stock<=5?"warning":"")">@(p.Stock==0?"Hết hàng":p.Stock<=5?"Sắp hết":"Còn hàng")</span></td><td><form asp-action="Inventory" method="post" class="inline-form inventory-adjustment"><input type="hidden" name="id" value="@p.Id"/><label class="sr-only" for="stock-@p.Id">Tồn kho @p.Name</label><input id="stock-@p.Id" name="quantity" type="number" value="@p.Stock" min="0" max="100000"/><button class="button-secondary compact">Lưu tồn kho</button></form></td></tr>}</tbody></table></div>

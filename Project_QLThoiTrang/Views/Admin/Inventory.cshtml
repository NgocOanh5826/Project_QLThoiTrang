@*
    VAI TRÒ VIEW: Mở kiểm kê tồn tổng theo sản phẩm, kèm 200 biến động kho gần nhất. DỮ LIỆU MODEL:
    List<Product>. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và AdminExtensions.cs; tra
    HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model List<Product>
@{
    ViewData["CreateUrl"] = "/Admin/Receive";
    ViewData["CreateLabel"] = "Nhập kho";
    ViewData["Title"] = "Quản lý tồn kho";
}
@{
    ViewData["TableFilters"] = new[]
    {
        new AdminListFilter("category", "Danh mục"),
        AdminListFilter.Choice("stock", "Tồn kho", ("empty", "Hết hàng"), ("low", "Sắp hết (1–5)"),
    ("normal", "Còn hàng (>5)"))
    };
}
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_AdminListToolbar.cshtml. Thanh tìm kiếm/lọc danh sách quản
    trị dùng lại qua partial; thuộc tính data-* kết nối với bộ xử lý lọc trong wwwroot/js/site.js.
*@
<partial name="_AdminListToolbar"/>
<div class="panel table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Hiện có</th>
                <th>Tình trạng</th>
                <th>Điều chỉnh tồn thực tế</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr
                    data-filter-category="@p.Category"
                    data-filter-stock="@(p.Stock == 0 ? "empty" : p.Stock <= 5 ? "low" : "normal")"
                >
                    <td>
                        <div class="table-product">
                            <img src="@p.Image" alt=""/>
                            <strong>@p.Name</strong>
                        </div>
                    </td>
                    <td>@p.Stock</td>
                    <td>
                        <span class="status @(p.Stock <= 5 ? "warning" : "")">@(p.Stock == 0
                            ? "Hết hàng" : p.Stock <= 5 ? "Sắp hết" : "Còn hàng")</span>
                    </td>
                    <td class="table-actions-cell">
                        <div class="table-actions">
                            <a
                                class="button-secondary compact table-action"
                                href="/Admin/VariantStock"
                            >Kiểm kê theo biến thể</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

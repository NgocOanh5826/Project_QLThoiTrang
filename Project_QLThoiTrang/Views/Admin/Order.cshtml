@*
    VAI TRÒ VIEW: Mở chi tiết đơn theo mã công khai, không có thì trả 404; dữ liệu hiển thị không
    được sửa ngay tại GET. DỮ LIỆU MODEL: Order. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model Order
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.Id;
    var states = Model.Status switch
    {
        "Chờ xác nhận" => new[]
        {
            "Đã xác nhận",
            "Đã hủy"
        },
        "Đã xác nhận" => new[]
        {
            "Đang chuẩn bị",
            "Đang giao",
            "Đã hủy"
        },
        "Đang chuẩn bị" => new[]
        {
            "Đang giao",
            "Đã hủy"
        },
        "Đang giao" => new[]
        {
            "Đã giao"
        },
        "Đã giao" => new[]
        {
            "Hoàn thành"
        },
        _ => Array.Empty<string>()};
}
<div class="checkout-grid">
    <div class="panel">
        <div class="section-title">
            <h2>Sản phẩm đã đặt</h2>
            <span class="status">@Model.Status</span>
        </div>
        @*
            THÀNH PHẦN DÙNG CHUNG: Views/Shared/_OrderLines.cshtml. Bảng chi tiết sản phẩm trong
            đơn, gồm biến thể, giá và lượng; giá là ảnh chụp lúc đặt, không phải ô sửa giá bán.
        *@
        <partial name="_OrderLines" model="Model"/>
    </div>
    <aside class="panel form-stack">
        <h2>Thông tin nhận hàng</h2>
        <p>
            @Model.Name
            <br/>
            @Model.Phone
            <br/>
            @Model.Address
        </p>
        <p class="muted">
            @Model.Created.ToString("dd/MM/yyyy HH:mm")
            <br/>
            @Model.Payment
        </p>
        <p>@Model.Note</p>
        @if (states.Length > 0)
        {
            @*
                FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới
                /Admin/OrderStatus. Controller nhận dữ liệu và kiểm tra ModelState/quyền; service
                kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token chống CSRF khi áp
                dụng. CHỨC NĂNG: Nhận trạng thái mới, chuyển điều kiện chuyển bước/thu tiền/hoàn tồn
                sang StoreService.ChangeOrderStatus; báo kết quả bằng TempData rồi quay lại chi tiết
                đơn.Các thuộc tính data-* nối form với sự kiện JavaScript trong wwwroot/js.
            *@
            <form
                asp-action="OrderStatus"
                method="post"
                class="form-stack"
                data-confirm="Xác nhận cập nhật trạng thái đơn hàng?"
            >
                <input type="hidden" name="id" value="@Model.Id"/>
                <label>
                    Bước tiếp theo
                    <select name="status">
                        @foreach (var state in states)
                        {
                            <option>@state</option>
                        }
                    </select>
                </label>
                <button class="btn-black">Cập nhật trạng thái</button>
            </form>
        }
        else
        {
            <p class="notice">Đơn đã hoàn tất hoặc đã hủy. Không sửa lịch sử.</p>
        }
        <a href="/Admin/Orders" class="button-secondary">Tất cả đơn hàng</a>
    </aside>
</div>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_PaymentStatus.cshtml. Hiển thị trạng thái tiền đã thu/hoàn
    và hướng dẫn liên quan; Admin/Payment mới là điểm nhận thao tác ghi nhận thu tiền.
*@
<partial name="_PaymentStatus" model="Model"/>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_OrderHistory.cshtml. Hiển thị các mốc lịch sử trạng thái
    đơn được Load từ SQL; thao tác đổi trạng thái xử lý ở Admin/OrderStatus.
*@
<partial name="_OrderHistory" model="Model"/>
<div class="actions toolbar-actions">
    <a href="/Documents/Order/@Model.Id" class="button-secondary">Tải PDF đơn hàng</a>
</div>
<a href="/Shipping?id=@Model.Id" class="button-secondary">Vận đơn GHN</a>
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_ShipmentStatus.cshtml. Hiển thị vận đơn hiện có và liên kết
    quản lý giao hàng; ShippingController nhận lệnh tạo/đồng bộ GHN.
*@
<partial name="_ShipmentStatus" model="Model"/>

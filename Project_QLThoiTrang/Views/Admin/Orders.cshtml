@model List<Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<form method="get" class="filter-bar admin-list-toolbar" data-admin-server-filter>
    <label class="admin-list-search">
        Tìm đơn
        <input name="q" value="@ViewBag.Query" placeholder="Mã đơn, người nhận hoặc điện thoại"/>
    </label>
    <label>
        Trạng thái
        <select name="status">
            <option value="">Tất cả</option>
            @foreach (var status in new[]
            {
                "Chờ xác nhận",
                "Đã xác nhận",
                "Đang chuẩn bị",
                "Đang giao",
                "Đã giao",
                "Hoàn thành",
                "Đã hủy",
                "Đã hoàn hàng"
            }
            )
            {
                <option value="@status" selected="@(ViewBag.Status == status)">@status</option>
            }
        </select>
    </label>
    <label>
        Thanh toán
        <select name="payment">
            <option value="">Tất cả</option>
            @foreach (var method in new[]
            {
                "COD",
                "Chuyển khoản",
                "Ví điện tử"
            }
            )
            {
                <option value="@method" selected="@(ViewBag.Payment == method)">@method</option>
            }
        </select>
    </label>
    <label>
        Thời gian
        <select name="period">
            <option value="">Toàn bộ</option>
            <option value="today" selected="@(ViewBag.Period == "today")">Hôm nay</option>
            <option value="last7" selected="@(ViewBag.Period == "last7")">7 ngày gần nhất</option>
            <option value="last30" selected="@(ViewBag.Period == "last30")">
                30 ngày gần nhất
            </option>
        </select>
    </label>
    <button class="button-secondary">Lọc</button>
    <a href="/Admin/Orders" class="button-secondary">Xóa bộ lọc</a>
    <span class="muted small admin-filter-count">@Model.Count / @ViewBag.Total bản ghi</span>
    <a href="/Admin/Export" class="button-secondary">Xuất CSV</a>
</form>
<div class="panel table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Trạng thái</th>
                <th>Thanh toán</th>
                <th>Tổng tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Id</td>
                    <td>@o.Name</td>
                    <td>@o.Created.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="status">@o.Status</span>
                    </td>
                    <td>@o.Payment</td>
                    <td>@o.Total.ToString("N0") đ</td>
                    <td class="table-actions-cell">
                        <div class="table-actions">
                            <a
                                asp-action="Order"
                                asp-route-id="@o.Id"
                                class="button-secondary compact table-action"
                            >Chi tiết</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <p class="empty-state">Chưa có đơn hàng phù hợp.</p>
    }
</div>

@*
    VAI TRÒ VIEW: Mở form thêm khi không có id, hoặc tìm sản phẩm để sửa khi có id; chuẩn bị thương
    hiệu/danh mục, không tìm thấy trả 404. DỮ LIỆU MODEL: Product. ĐIỂM XỬ LÝ:
    Controllers/AdminController.cs và AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload
    GET/POST.
*@

@model Product
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm sản phẩm" : "Chỉnh sửa sản phẩm";
}
@*
    FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Admin/Product. asp-for liên
    kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra ModelState/quyền; service
    kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token chống CSRF khi áp dụng. CHỨC
    NĂNG: Nhận form thêm/sửa sản phẩm. Kiểm tra danh mục có thật, ảnh thuộc thư viện và ModelState;
    Id = 0 cấp mã, ép tồn ban đầu về 0 rồi Add; Id khác 0 tìm bản ghi và giữ nguyên tồn cũ khi thay
    thông tin.
*@
<form asp-action="Product" method="post" class="panel form-stack">
    <input asp-for="Id" type="hidden"/>
    @*
        THÔNG BÁO LỖI: Razor hiển thị các lỗi ModelState do binding, DataAnnotations hoặc controller
        thêm; sửa ô bị lỗi rồi gửi lại form.
    *@
    <div asp-validation-summary="All" class="validation"></div>
    <div class="form-grid">
        <label>
            Tên sản phẩm
            <input asp-for="Name"/>
        </label>
        <label>
            Danh mục
            <select asp-for="Category">
                @foreach (var category in (List<string>)ViewBag.Categories)
                {
                    <option>@category</option>
                }
            </select>
        </label>
        <label>
            Thương hiệu
            <select asp-for="BrandId">
                <option value="">Không chọn</option>
                @foreach (var b in (List<ReferenceInput>)ViewBag.Brands)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </label>
        <label>
            Giá bán (đ)
            <input asp-for="Price" type="number" min="1000" step="1000"/>
        </label>
        <label>
            Tồn kho tổng
            <input asp-for="Stock" type="number" min="0" readonly/>
            <small>Thay đổi tại Nhập kho / Kiểm kê.</small>
        </label>
        <label>
            Màu mặc định khi thêm
            <input asp-for="Color" readonly="@(Model.Id > 0)"/>
            <small>Màu của sản phẩm đã tạo được quản lý tại Biến thể.</small>
        </label>
        <label>
            Ảnh sản phẩm
            <select asp-for="Image">
                @for (int i = 1; i <= 5; i++)
                {
                    <option value="/images/products/aothun@(i.ToString("00")).jpg">
                        Ảnh sản phẩm @i
                    </option>
                }
            </select>
        </label>
    </div>
    <label>
        Mô tả
        <textarea asp-for="Description" rows="4"></textarea>
    </label>
    <div class="actions">
        <label class="checkbox">
            <input asp-for="Active"/>
            Đang bán
        </label>
        <label class="checkbox">
            <input asp-for="IsNew"/>
            Hàng mới
        </label>
        <label class="checkbox">
            <input asp-for="OnSale"/>
            Bộ sưu tập ưu đãi
        </label>
    </div>
    <div class="actions">
        <button class="btn-black">Lưu sản phẩm</button>
        <a href="/Admin/Products" class="button-secondary">Quay lại</a>
    </div>
</form>

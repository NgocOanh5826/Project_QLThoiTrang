@model Product
@using Project_QLThoiTrang.Services
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm sản phẩm" : "Chỉnh sửa sản phẩm";
}

<form asp-action="Product" method="post" enctype="multipart/form-data"
      class="panel form-stack" data-product-form>
    <input asp-for="Id" type="hidden"/>

    <div asp-validation-summary="All" class="validation"></div>
    <div class="form-grid">
        <label>
            Tên sản phẩm
            <input asp-for="Name"/>
        </label>
        <div class="form-stack">
            <label for="Category">Danh mục</label>
            <select asp-for="Category">
                <option value="">Chọn danh mục</option>
                @foreach (var category in (List<string>)ViewBag.Categories)
                {
                    <option>@category</option>
                }
            </select>
            <a href="/Admin/Category">Thêm danh mục mới</a>
        </div>
        <label>
            Thương hiệu
            <select asp-for="BrandId">
                <option value="">Không chọn</option>
                @foreach (var b in (List<ReferenceInput>)ViewBag.Brands)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </label>
        <label>
            Giá bán (đ)
            <input asp-for="Price" type="number" min="1000" step="1000"/>
        </label>
        <label>
            Tồn kho tổng
            <input asp-for="Stock" type="number" min="0" readonly/>
            <small>Thay đổi tại Nhập kho / Kiểm kê.</small>
        </label>
        <label>
            Màu mặc định khi thêm
            <input asp-for="Color" readonly="@(Model.Id > 0)"/>
            <small>Màu của sản phẩm đã tạo được quản lý tại Biến thể.</small>
        </label>
        <label>
            Ảnh sản phẩm
            <select asp-for="Image">
                @if (ProductImages.IsAllowedPath(Model.Image)
                    && Model.Image.StartsWith("/images/products/uploads/"))
                {
                    <option value="@Model.Image">Ảnh hiện tại</option>
                }
                @for (int i = 1; i <= 5; i++)
                {
                    <option value="/images/products/aothun@(i.ToString("00")).jpg">
                        Ảnh sản phẩm @i
                    </option>
                }
            </select>
        </label>
        <div class="form-stack">
            <label for="imageFile">Tải ảnh mới lên</label>
            <input id="imageFile" name="imageFile" type="file"
                   accept="image/jpeg,image/png,image/gif,image/webp" data-product-image-file />
            <small>JPG, PNG, GIF hoặc WebP, tối đa 5 MB. Bỏ trống để giữ ảnh đang chọn.</small>
            <img src="@Model.Image" alt="Xem trước ảnh sản phẩm" data-product-image-preview
                 style="width:160px;height:180px;object-fit:contain;border-radius:12px" />
        </div>
    </div>
    <label>
        Mô tả
        <textarea asp-for="Description" rows="4"></textarea>
    </label>
    <div class="actions">
        <label class="checkbox">
            <input asp-for="Active"/>
            Đang bán
        </label>
        <label class="checkbox">
            <input asp-for="IsNew"/>
            Hàng mới
        </label>
        <label class="checkbox">
            <input asp-for="OnSale"/>
            Bộ sưu tập ưu đãi
        </label>
    </div>
    <div class="actions">
        <button class="btn-black">Lưu sản phẩm</button>
        <a href="/Admin/Products" class="button-secondary">Quay lại</a>
    </div>
</form>
<script src="~/js/product-form.js" asp-append-version="true"></script>

@model Product
@{ViewData["Title"]=Model.Id==0?"Thêm sản phẩm":"Chỉnh sửa sản phẩm";}
<form asp-action="Product" method="post" class="panel form-stack"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Tên sản phẩm<input asp-for="Name"/></label><label>Danh mục<select asp-for="Category">@foreach(var category in (List<string>)ViewBag.Categories){<option>@category</option>}</select></label><label>Giá bán (đ)<input asp-for="Price" type="number" min="1000" step="1000"/></label><label>Tồn kho tổng<input asp-for="Stock" type="number" min="0"/></label><label>Màu sắc<input asp-for="Color"/></label><label>Ảnh sản phẩm<select asp-for="Image">@for(int i=1;i<=5;i++){<option value="/images/products/aothun@(i.ToString("00")).jpg">Ảnh sản phẩm @i</option>}</select></label></div><label>Mô tả<textarea asp-for="Description" rows="4"></textarea></label><div class="actions"><label class="checkbox"><input asp-for="Active"/>Đang bán</label><label class="checkbox"><input asp-for="IsNew"/>Hàng mới</label><label class="checkbox"><input asp-for="OnSale"/>Bộ sưu tập ưu đãi</label></div><div class="actions"><button class="btn-black">Lưu sản phẩm</button><a href="/Admin/Products" class="button-secondary">Quay lại</a></div></form>

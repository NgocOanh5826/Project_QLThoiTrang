@*
    VAI TRÒ VIEW: Mở form thêm khi id trống hoặc form sửa theo id; nạp danh sách sản phẩm áp dụng,
    không tìm thấy trả 404. DỮ LIỆU MODEL: Promotion. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model Promotion
@{
    ViewData["Title"] = "Chương trình ưu đãi";
}
@*
    FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Admin/Promotion. asp-for
    liên kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra ModelState/quyền;
    service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token chống CSRF khi áp dụng.
    CHỨC NĂNG: Thêm/sửa ưu đãi: kiểm tra ngày, loại PHANTRAM/SOTIEN, giá trị/hạn mức/lượt, sản phẩm
    áp dụng và mã chưa trùng; chuẩn hóa mã chữ hoa. Id = 0 thêm mới, khác 0 cập nhật dòng tìm được.
*@
<form method="post" class="panel form-stack">
    <input asp-for="Id" type="hidden"/>
    @*
        THÔNG BÁO LỖI: Razor hiển thị các lỗi ModelState do binding, DataAnnotations hoặc controller
        thêm; sửa ô bị lỗi rồi gửi lại form.
    *@
    <div asp-validation-summary="All" class="validation"></div>
    <label>
        Tên
        <input asp-for="Name"/>
    </label>
    <label>
        Mã
        <input asp-for="Code"/>
    </label>
    <label>
        Loại giảm
        <select asp-for="Kind">
            <option value="PHANTRAM">Phần trăm</option>
            <option value="SOTIEN">Số tiền</option>
        </select>
    </label>
    <label>
        Giá trị giảm
        <input asp-for="Value" type="number" min="1" max="100000000" required/>
    </label>
    <label>
        Đơn tối thiểu
        <input asp-for="Minimum" type="number" min="0"/>
    </label>
    <label>
        Giảm tối đa (để trống nếu không giới hạn)
        <input asp-for="Maximum" type="number" min="0"/>
    </label>
    <label>
        Số lượt còn lại (để trống nếu không giới hạn)
        <input asp-for="Remaining" type="number" min="0"/>
    </label>
    <label>
        Ngày bắt đầu
        <input asp-for="From" type="date"/>
    </label>
    <label>
        Ngày kết thúc
        <input asp-for="Until" type="date"/>
    </label>
    <label class="checkbox">
        <input asp-for="Active"/>
        Đang hoạt động
    </label>
    <fieldset>
        <legend>Sản phẩm áp dụng (không chọn: toàn cửa hàng)</legend>
        @foreach (var p in (List<Product>)ViewBag.Products)
        {
            <label class="checkbox">
                <input
                    name="ProductIds"
                    value="@p.Id"
                    type="checkbox"
                    checked="@Model.ProductIds.Contains(p.Id)"
                />
                @p.Name
            </label>
        }
    </fieldset>
    <button class="btn-black">Lưu ưu đãi</button>
</form>

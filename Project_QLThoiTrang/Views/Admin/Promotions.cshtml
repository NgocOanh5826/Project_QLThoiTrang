@model List<Promotion>
@{ViewData["Title"]="Chương trình khuyến mãi";}
<div class="actions toolbar-actions"><a href="/Admin/Promotion" class="btn-black">Thêm chương trình</a></div><p class="notice">Quản lý chương trình và bộ sưu tập ưu đãi. Mã giảm giá chưa được áp dụng vào thanh toán demo.</p><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Chương trình</th><th>Mã</th><th>Mức giảm dự kiến</th><th>Kết thúc</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td><strong>@p.Code</strong></td><td>@p.Percent%</td><td>@p.Until.ToString("dd/MM/yyyy")</td><td><span class="status">@(p.Active&&p.Until.Date>=DateTime.Today?"Đang bật":"Ngừng / hết hạn")</span></td><td><a asp-action="Promotion" asp-route-id="@p.Id" class="button-secondary compact">Chỉnh sửa</a></td></tr>}</tbody></table></div>

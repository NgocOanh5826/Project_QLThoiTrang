@*
    VAI TRÒ VIEW: Mở form thêm danh mục khi id = 0 hoặc form sửa bản ghi cùng kind; loại sai trả
    400, id không có trả 404. DỮ LIỆU MODEL: ReferenceInput. ĐIỂM XỬ LÝ:
    Controllers/AdminController.cs và AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload
    GET/POST.
*@

@model ReferenceInput
@{
    var titles = new Dictionary<string, string>
    {
        {
            "brands",
            "thương hiệu"
        },
        {
            "sizes",
            "kích thước"
        },
        {
            "colors",
            "màu sắc"
        },
        {
            "warehouses",
            "kho"
        },
        {
            "suppliers",
            "nhà cung cấp"
        }
    };
    ViewData["Title"] = (Model.Id == 0 ? "Thêm " : "Chỉnh sửa ") + titles[Model.Kind];
    ViewData["ReferenceKind"] = Model.Kind;
}
<div class="admin-form-page">
    @*
        FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Admin/Reference.
        asp-for liên kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra
        ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token
        chống CSRF khi áp dụng. CHỨC NĂNG: Nhận form thương hiệu/size/màu/kho/NCC, kiểm tra kind và
        ModelState rồi SaveReference; lỗi giữ dữ liệu nhập và hiển thị lại form.
    *@
    <form asp-action="Reference" method="post" class="panel form-stack">
        @*
            THÔNG BÁO LỖI: Razor hiển thị các lỗi ModelState do binding, DataAnnotations hoặc
            controller thêm; sửa ô bị lỗi rồi gửi lại form.
        *@
        <div asp-validation-summary="All" class="validation"></div>
        <input asp-for="Id" type="hidden"/>
        <input asp-for="Kind" type="hidden"/>
        <label>
            Tên
            <input
                asp-for="Name"
                required
                maxlength="@(Model.Kind == "sizes" ? 30 : Model
                .Kind == "colors" ? 50 : 100)"
                autofocus
            />
        </label>
        @if (Model.Kind == "brands")
        {
            <label>
                Mô tả
                <textarea asp-for="Description" maxlength="500"></textarea>
            </label>
        }
        @if (Model.Kind == "colors")
        {
            <label>
                Mã màu
                <input asp-for="Description" maxlength="20" placeholder="#26372e"/>
            </label>
        }
        @if (Model.Kind is "warehouses" or "suppliers")
        {
            <label>
                Địa chỉ
                <input asp-for="Address" maxlength="255"/>
            </label>
        }
        @if (Model.Kind == "suppliers")
        {
            <label>
                Điện thoại
                <input asp-for="Phone" maxlength="15"/>
            </label>
            <label>
                Email
                <input asp-for="Email" type="email" maxlength="150"/>
            </label>
        }
        @if (Model.Kind is not ("sizes" or "colors"))
        {
            <label class="checkbox">
                <input asp-for="Active"/>
                Đang hoạt động
            </label>
        }
        <div class="actions">
            <button class="btn-black">Lưu</button>
            <a href="/Admin/References?kind=@Model.Kind" class="button-secondary">Hủy / quay lại</a>
        </div>
    </form>
</div>

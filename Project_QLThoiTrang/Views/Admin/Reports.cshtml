@*
    VAI TRÒ VIEW: Chọn khoảng ngày báo cáo từ bộ lọc nhanh hoặc from/to; ngày bắt đầu sau ngày kết
    thúc thì trả danh sách rỗng kèm lỗi. DỮ LIỆU MODEL: List<Order>. ĐIỂM XỬ LÝ:
    Controllers/AdminController.cs và AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload
    GET/POST.
*@

@model List<Order>
@inject Project_QLThoiTrang.Services.StoreService Store
@{
    ViewData["Title"] = "Báo cáo kinh doanh";
    var delivered = Model.Where(o => o.Status is "Đã giao" or "Hoàn thành").ToList();
    var returns = Store.Read(d => d.Returns.Where(r => r.Status == "Approved").SelectMany(r => r
    .Lines).ToList());
    var sales = delivered.SelectMany(o => o.Lines.Select(l => new { l.ProductId, l.Name, Quantity =
    l.Quantity - returns.Where(r => r.OrderLineId == l.Id).Sum(r => r.Quantity), Revenue = Math.Max(
    0, (o.Subtotal == 0 ? 0 : decimal.Round(l.Price * l.Quantity * (o.Subtotal - o.Discount) / o
    .Subtotal, 2)) - returns.Where(r => r.OrderLineId == l.Id).Sum(r => r.Refund)) })).ToList();
}
@*
    FORM GET: gửi các ô input/select/textarea theo thuộc tính name tới /Admin/Reports. Các giá trị
    được gửi trong query string để đọc/lọc dữ liệu. CHỨC NĂNG: Chọn khoảng ngày báo cáo từ bộ lọc
    nhanh hoặc from/to; ngày bắt đầu sau ngày kết thúc thì trả danh sách rỗng kèm lỗi.Các thuộc tính
    data-* nối form với sự kiện JavaScript trong wwwroot/js.
*@
<form method="get" class="filter-bar admin-list-toolbar" data-admin-date-filter>
    @*
        THÀNH PHẦN DÙNG CHUNG: Views/Shared/_AdminDatePeriod.cshtml. Các mốc thời gian nhanh cho báo
        cáo/danh sách; controller chuyển period thành from/to, JavaScript gửi lại form khi thay đổi.
    *@
    <partial name="_AdminDatePeriod"/>
    <label>
        Từ ngày
        <input type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"/>
    </label>
    <label>
        Đến ngày
        <input type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"/>
    </label>
    <button class="btn-black">Áp dụng</button>
    <a href="/Admin/Export" class="button-secondary">Xuất toàn bộ đơn CSV</a>
</form>
<div class="metrics">
    <div class="metric">
        <span>Tiền hàng sau giảm và hoàn</span>
        <strong>@delivered.Sum(o => o.NetMerchandiseRevenue).ToString("N0") đ</strong>
        <small>Không gồm phí vận chuyển</small>
    </div>
    <div class="metric">
        <span>Đơn trong kỳ</span>
        <strong>@Model.Count</strong>
        <small>Theo ngày đặt</small>
    </div>
    <div class="metric">
        <span>Đã giao / hoàn thành</span>
        <strong>@delivered.Count</strong>
    </div>
    <div class="metric">
        <span>Đơn đã hủy</span>
        <strong>@Model.Count(o => o.Status == "Đã hủy")</strong>
    </div>
</div>
<div class="panel table-scroll">
    <h2>Sản phẩm bán được sau trả hàng</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng còn bán</th>
                <th>Tiền hàng sau ưu đãi / hoàn</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in sales.GroupBy(x => x.ProductId))
            {
                <tr>
                    <td>@group.First().Name</td>
                    <td>@group.Sum(x => x.Quantity)</td>
                    <td>@group.Sum(x => x.Revenue).ToString("N0") đ</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="notice">
        Báo cáo theo ngày đặt và trạng thái hiện tại. Chưa phải báo cáo kế toán theo ngày thu/chi.
    </p>
</div>

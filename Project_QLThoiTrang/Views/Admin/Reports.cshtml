@model List<Order>
@{ViewData["Title"]="Báo cáo kinh doanh";var delivered=Model.Where(o=>o.Status=="Đã giao").ToList();var revenue=delivered.Sum(o=>o.Subtotal);var total=Model.Count;}
<form method="get" class="filter-bar"><label>Từ ngày<input type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"/></label><label>Đến ngày<input type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"/></label><button class="btn-black">Áp dụng</button><a href="/Admin/Export" class="button-secondary">Xuất toàn bộ đơn CSV</a></form><div class="metrics"><div class="metric"><span>Doanh thu hàng đã giao</span><strong>@revenue.ToString("N0") đ</strong><small>Không tính phí vận chuyển</small></div><div class="metric"><span>Đơn hàng trong kỳ</span><strong>@total</strong><small>Theo ngày đặt hàng</small></div><div class="metric"><span>Đơn đã giao</span><strong>@delivered.Count</strong><small>Trạng thái đã hoàn tất</small></div><div class="metric"><span>Đơn đã hủy</span><strong>@Model.Count(o=>o.Status=="Đã hủy")</strong><small>Đã hoàn tồn kho</small></div></div><div class="panel"><h2>Sản phẩm bán được</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Số lượng đã giao</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var group in delivered.SelectMany(o=>o.Lines).GroupBy(l=>l.ProductId)){<tr><td>@group.First().Name</td><td>@group.Sum(l=>l.Quantity)</td><td>@group.Sum(l=>l.Quantity*l.Price).ToString("N0") đ</td></tr>}</tbody></table></div>@if(delivered.Count==0){<p class="empty-state">Chưa có đơn đã giao trong kỳ.</p>}</div>

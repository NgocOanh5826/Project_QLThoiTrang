@*
    VAI TRÒ VIEW: Mở chi tiết một phiếu trả hàng, bọc thành danh sách để dùng chung model/view hiển
    thị. DỮ LIỆU MODEL: List<ReturnRecord>. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model List<ReturnRecord>
@{
    ViewData["Title"] = "Xử lý trả hàng";
}
<p class="notice">
    Hỗ trợ trả từng phần hoặc toàn bộ đơn. Chỉ duyệt khi đã nhận và kiểm tra hàng có thể nhập lại
    kho, đồng thời đã hoàn đúng số tiền của yêu cầu; hoàn phí giao hàng khi trả nốt toàn bộ. Ghi mã
    chứng từ thực tế; hệ thống không tự chuyển tiền.
</p>
@foreach (var r in Model)
{
    <section class="panel form-stack">
        <a class="button-secondary compact" href="/Documents/Return/@r.Id">PDF phiếu trả</a>
        <h2>
            <a href="/Admin/Order/@r.OrderId">@r.OrderId</a>
        </h2>
        <p>@r.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @r.Status</p>
        <p>@r.Reason</p>
        <p>Số tiền hoàn: @r.Refund.ToString("N0") đ</p>
        @foreach (var line in r.Lines)
        {
            <p>Dòng @line.OrderLineId: @line.Quantity sản phẩm</p>
        }
        @if (r.Status == "Pending")
        {
            @*
                FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới
                /Admin/ResolveReturn. Controller nhận dữ liệu và kiểm tra ModelState/quyền; service
                kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token chống CSRF khi áp
                dụng. CHỨC NĂNG: Nhận nút duyệt/từ chối, ghi chú và chứng từ hoàn tiền;
                ResolveReturn ở service kiểm tra phiếu Pending, hoàn tồn và ghi tiền hoàn khi được
                duyệt.Các thuộc tính data-* nối form với sự kiện JavaScript trong wwwroot/js.
            *@
            <form
                asp-action="ResolveReturn"
                method="post"
                class="form-stack"
                data-confirm="Xác nhận kết quả trả hàng và chứng từ thực tế?"
            >
                <input type="hidden" name="id" value="@r.Id"/>
                <label>
                    Ghi chú xử lý
                    <textarea name="resolution" minlength="5" maxlength="500" required></textarea>
                </label>
                <label>
                    Mã chứng từ hoàn tiền (bắt buộc khi duyệt)
                    <input name="reference" maxlength="100"/>
                </label>
                <button class="btn-black" name="approve" value="true">
                    Đã nhận hàng và hoàn tiền — duyệt
                </button>
                <button class="button-secondary" name="approve" value="false">
                    Từ chối yêu cầu
                </button>
            </form>
        }
        else
        {
            <p>@r.Resolution · @r.Resolved?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        }
    </section>
}
@if (Model.Count == 0)
{
    <p class="empty-state">Chưa có yêu cầu trả hàng.</p>
}
<a href="/Admin/Returns" class="button-secondary">Quay lại danh sách</a>

@model List<ReviewItem>
@{ViewData["Title"]="Quản lý đánh giá";}
@{ViewData["TableFilters"]=new[]{AdminListFilter.Choice("state","Hiển thị",("active","Đang hiển thị"),("inactive","Đã ẩn")),new AdminListFilter("stars","Số sao"),new AdminListFilter("product","Sản phẩm")};}
<partial name="_AdminListToolbar"/><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Khách</th><th>Sao</th><th>Nội dung</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr data-filter-state="@(r.Active?"active":"inactive")" data-filter-stars="@r.Stars" data-filter-product="@r.ProductId" data-filter-product-label="@(((Dictionary<int,string>)ViewBag.ProductNames).GetValueOrDefault(r.ProductId))"><td>@r.ProductId</td><td>@r.Customer</td><td>@r.Stars / 5</td><td>@r.Text</td><td class="table-actions-cell"><div class="table-actions"><form asp-action="Moderate" method="post"><input name="id" value="@r.Id" type="hidden"/><input name="active" value="@((!r.Active).ToString().ToLowerInvariant())" type="hidden"/><button class="table-action @(r.Active?"table-action--danger":"")">@(r.Active?"Ẩn":"Hiện")</button></form></div></td></tr>}</tbody></table></div>

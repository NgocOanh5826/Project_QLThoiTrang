@*
    VAI TRÒ VIEW: Mở danh sách nhân viên hoặc chuyển sang StaffMember nếu có id cần sửa; chỉ Admin
    được qua bộ lọc quyền action này. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@{
    ViewData["FilterStatus"] = true;
    ViewData["Title"] = "Nhân viên và phân quyền";
    ViewData["CreateUrl"] = "/Admin/StaffMember";
    ViewData["CreateLabel"] = "Thêm nhân viên";
}
@{
    ViewData["TableFilters"] = new[]
    {
        AdminListFilter.Choice("state", "Trạng thái", ("active", "Đang hoạt động"), ("inactive",
    "Ngừng hoạt động")),
        AdminListFilter.Choice("role", "Vai trò", ("Admin", "Quản trị"), ("Catalog", "Sản phẩm"), (
    "Inventory", "Kho"), ("Sales", "Bán hàng"), ("Support", "Hỗ trợ"))
    };
}
@*
    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_AdminListToolbar.cshtml. Thanh tìm kiếm/lọc danh sách quản
    trị dùng lại qua partial; thuộc tính data-* kết nối với bộ xử lý lọc trong wwwroot/js/site.js.
*@
<partial name="_AdminListToolbar"/>
<div class="panel table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Hoạt động</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in (List<Customer>)ViewBag.Staff)
            {
                <tr data-filter-role="@c.Role" data-state="@(c.Active ? "active" : "inactive")">
                    <td>@c.Name</td>
                    <td>@c.Email</td>
                    <td>@c.Role</td>
                    <td>@c.Active</td>
                    <td class="table-actions-cell">
                        <div class="table-actions">
                            <a
                                href="/Admin/StaffMember/@(-c.Id)"
                                title="Sửa, khóa hoặc đặt lại mật khẩu nhân viên"
                                class="table-action"
                            >Sửa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

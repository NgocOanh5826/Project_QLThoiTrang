@*
    VAI TRÒ VIEW: Mở form kiểm kê một biến thể tại kho; bắt buộc biến thể tồn tại và kho đang hoạt
    động. DỮ LIỆU MODEL: StoreData. ĐIỂM XỬ LÝ: Controllers/AdminController.cs và
    AdminExtensions.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model StoreData
@{
    ViewData["Title"] = "Kiểm kê tồn kho";
    int variantId = ViewBag.VariantId;
    int warehouseId = ViewBag.WarehouseId;
    var v = Model.Variants.Single(v => v.Id == variantId);
    var w = Model.Warehouses.Single(w => w.Id == warehouseId);
    var quantity = Model.Stocks.FirstOrDefault(s => s.VariantId == variantId && s
    .WarehouseId == warehouseId)?.Quantity ?? 0;
}
<div class="admin-form-page">
    @*
        FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Admin/AdjustVariant.
        Controller nhận dữ liệu và kiểm tra ModelState/quyền; service kiểm tra nghiệp vụ trước khi
        lưu. TagHelper form POST tạo token chống CSRF khi áp dụng. CHỨC NĂNG: Nhận kiểm kê biến
        thể/kho, số tồn expected và lý do; service kiểm tra rồi lưu, sau đó quay lại StockCount đúng
        biến thể/kho.
    *@
    <form asp-action="AdjustVariant" method="post" class="panel form-stack">
        <h2>@Model.Products.Single(p => p.Id == v.ProductId).Name</h2>
        <p>@w.Name · @v.Sku · @v.Size / @v.Color</p>
        <input name="variantId" value="@v.Id" type="hidden"/>
        <input name="warehouseId" value="@w.Id" type="hidden"/>
        <input name="expected" value="@quantity" type="hidden"/>
        <label>
            Tồn thực tế
            <input name="quantity" value="@quantity" type="number" min="0" max="100000" required/>
        </label>
        <label>
            Lý do kiểm kê
            <textarea name="reason" minlength="5" maxlength="300" required></textarea>
        </label>
        <div class="actions">
            <button class="btn-black">Ghi kiểm kê</button>
            <a href="/Admin/VariantStock" class="button-secondary">Quay lại danh sách</a>
        </div>
    </form>
</div>

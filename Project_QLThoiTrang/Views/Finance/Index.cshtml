@model List<ProfitLine>
@{
    ViewData["Title"] = "Lợi nhuận và giá vốn";
    var missing = Model.Where(l => !l.Cost.HasValue).ToList();
}

<form method="get" class="filter-bar admin-list-toolbar" data-admin-date-filter>

    <partial name="_AdminDatePeriod"/>
    <label>
        Từ ngày
        <input name="from" type="date" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"/>
    </label>
    <label>
        Đến ngày
        <input name="to" type="date" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"/>
    </label>
    <button class="btn-black">Áp dụng</button>
    <a href="/Finance/Suppliers" class="button-secondary">Công nợ nhà cung cấp</a>
</form>

<div asp-validation-summary="All" class="validation"></div>
<div class="metrics">
    <div class="metric">
        <span>Tiền hàng thuần</span>
        <strong>@Model.Sum(l => l.Revenue).ToString("N0") đ</strong>
    </div>
    <div class="metric">
        <span>Giá vốn đã xác định</span>
        <strong>@Model.Sum(l => l.Cost ?? 0).ToString("N0") đ</strong>
    </div>
    <div class="metric">
        <span>Lợi nhuận gộp</span>
        <strong>@(missing.Count == 0 ? (Model.Sum(l => l.Revenue) - Model.Sum(l => l.Cost ?? 0))
            .ToString("N0") + " đ" : "Chưa đủ giá vốn")</strong>
    </div>
    <div class="metric">
        <span>Dòng thiếu giá vốn</span>
        <strong>@missing.Count</strong>
    </div>
</div>
<p class="notice">
    Bình quân di động theo biến thể; giá vốn được chốt khi đặt hàng. Trả hàng giảm doanh thu và giá
    vốn theo số thực trả. Đơn cũ thiếu giá vốn giữ trạng thái chưa xác định. Lợi nhuận gộp chưa trừ
    vận chuyển, lương, thuê mặt bằng, thuế; kỳ báo cáo theo ngày đặt.
</p>
<div class="panel table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Đơn</th>
                <th>Sản phẩm</th>
                <th>SL còn bán</th>
                <th>Tiền hàng thuần</th>
                <th>Giá vốn</th>
                <th>Lãi gộp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>
                        <a href="/Admin/Order/@l.OrderId">@l.OrderId</a>
                    </td>
                    <td>@l.Product</td>
                    <td>@l.Quantity</td>
                    <td>@l.Revenue.ToString("N0")</td>
                    <td>@(l.Cost?.ToString("N0") ?? "Chưa xác định")</td>
                    <td>@(l.Profit?.ToString("N0") ?? "Chưa xác định")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

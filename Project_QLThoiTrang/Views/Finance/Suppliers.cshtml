@model List<SupplierPayment>
@{ViewData["Title"]="Công nợ nhà cung cấp";var receipts=(List<Project_QLThoiTrang.Data.Native.PhieuNhapRow>)ViewBag.Receipts;var accounts=(List<SupplierAccount>)ViewBag.Accounts;var suppliers=(List<Supplier>)ViewBag.Suppliers;decimal total=accounts.Sum(a=>a.Amount),paid=Model.Sum(p=>p.Amount);}
<div class="metrics"><div class="metric"><span>Phải trả đã đối soát</span><strong>@total.ToString("N0") đ</strong></div><div class="metric"><span>Đã chi</span><strong>@paid.ToString("N0") đ</strong></div><div class="metric"><span>Còn nợ</span><strong>@((total-paid).ToString("N0")) đ</strong></div><div class="metric"><span>Phiếu chưa đối soát</span><strong>@receipts.Count(r=>!accounts.Any(a=>a.ReceiptId==r.MaPhieuNhap))</strong></div></div>
<p class="notice">Phiếu nhập mới ghi số phải trả theo tổng chi tiết. Phiếu lịch sử cần đối soát trước khi ghi chi. Thanh toán nhà cung cấp là ghi nhận chứng từ đã chi bên ngoài hệ thống.</p>@{ViewData["TableFilters"]=new[]{new AdminListFilter("supplier","Nhà cung cấp"),AdminListFilter.Choice("debt","Công nợ",("unknown","Chưa đối soát"),("owing","Còn nợ"),("settled","Đã thanh toán đủ")),new AdminListFilter("month","Tháng nhập")};}
<partial name="_AdminListToolbar"/>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Nhà cung cấp</th><th>Phiếu</th><th>Ngày nhập</th><th>Phải trả</th><th>Đã chi</th><th>Còn nợ</th><th></th></tr></thead><tbody>@foreach(var p in receipts){var a=accounts.FirstOrDefault(a=>a.ReceiptId==p.MaPhieuNhap);var amount=Model.Where(x=>x.ReceiptId==p.MaPhieuNhap).Sum(x=>x.Amount);<tr data-filter-supplier="@p.MaNCC" data-filter-supplier-label="@suppliers.FirstOrDefault(s=>s.Id==p.MaNCC)?.Name" data-filter-debt="@(a==null?"unknown":a.Amount>amount?"owing":"settled")" data-filter-month="@p.NgayNhap.ToString("yyyy-MM")"><td>@suppliers.FirstOrDefault(s=>s.Id==p.MaNCC)?.Name</td><td>@p.MaPhieuNhap</td><td>@p.NgayNhap.ToString("dd/MM/yyyy")</td><td>@(a?.Amount.ToString("N0")??"Chưa đối soát")</td><td>@amount.ToString("N0")</td><td>@(a==null?"Chưa xác định":(a.Amount-amount).ToString("N0"))</td><td class="table-actions-cell"><div class="table-actions"><a href="/Finance/Receipt/@p.MaPhieuNhap" class="button-secondary compact table-action">Đối soát / chi tiền</a></div></td></tr>}</tbody></table></div>

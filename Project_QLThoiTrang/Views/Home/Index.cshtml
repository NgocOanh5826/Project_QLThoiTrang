@model List<Product>
@{
    ViewData["Title"] = "Trang chủ";
}
<section class="hero">
    <img src="~/images/banners/banner02.jpg" alt="Bộ sưu tập QOANH" fetchpriority="high"/>
    <div class="hero-content">
        <p class="hero-small">THIẾT KẾ CHO MỖI NGÀY</p>
        <h1>
            LIFE
            <br/>
            WEAR
        </h1>
        <p class="hero-description">Những điều giản đơn. Một phong cách riêng.</p>
        <div class="hero-buttons">
            <a href="/Shop?category=Nữ" class="btn-white">KHÁM PHÁ NỮ</a>
            <a href="/Shop?category=Nam" class="btn-white">KHÁM PHÁ NAM</a>
        </div>
    </div>
</section>
<section class="section home-categories">
    <div class="section-title">
        <h2>Khám phá danh mục</h2>
        <a href="/Shop">Tất cả sản phẩm →</a>
    </div>
    <div class="category-grid">
        @{
            int image = 1;
        }
        @foreach (var category in new[]
        {
            "Nữ",
            "Nam",
            "Trẻ em",
            "Phụ kiện"
        }
        )
        {
            <a
                asp-controller="Shop"
                asp-action="Index"
                asp-route-category="@category"
                class="category-card"
            >
                <img
                    src="/images/products/aothun@(image.ToString("00")).jpg"
                    alt="@category"
                    loading="lazy"
                />
                <div class="category-name">@category.ToUpper()</div>
            </a>
            image++; }
    </div>
</section>
<section class="section home-products">
    <div class="section-title">
        <h2>Được yêu thích mỗi ngày</h2>
        <a href="/Shop">Xem tất cả →</a>
    </div>
    <div class="product-grid">
        @foreach (var product in Model.Take(4))
        {

            <partial name="_ProductCard" model="product"/>
        }
    </div>
</section>
<section class="collection-banner">
    <img src="~/images/banners/banner02.jpg" alt="Bộ sưu tập Everyday Comfort" loading="lazy"/>
    <div class="collection-content">
        <p>THE EVERYDAY EDIT</p>
        <h2>
            EVERYDAY
            <br/>
            COMFORT
        </h2>
        <a href="/Shop?collection=new" class="btn-black">KHÁM PHÁ BỘ SƯU TẬP</a>
    </div>
</section>
<section class="section home-products">
    <div class="section-title">
        <h2>Hàng mới về</h2>
        <a href="/Shop?collection=new">Khám phá →</a>
    </div>
    <div class="product-grid">
        @foreach (var product in Model.Where(p => p.IsNew).Take(4))
        {

            <partial name="_ProductCard" model="product"/>
        }
    </div>
</section>
<section class="brand-section">
    <div class="brand-content">
        <h2>
            ĐƠN GIẢN.
            <br/>
            TINH TẾ.
            <br/>
            MỖI NGÀY.
        </h2>
        <p>
            Chất liệu dễ chịu. Phom dáng dễ mặc. Những thiết kế giúp bạn cảm thấy tự tin theo cách
            của riêng mình.
        </p>
        <a href="/Home/Info/about" class="text-link">Câu chuyện của chúng tôi →</a>
    </div>
</section>

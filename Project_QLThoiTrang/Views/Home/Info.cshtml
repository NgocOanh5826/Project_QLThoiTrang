@model StoreSettings
<section class="page-section narrow">
    <p class="eyebrow">QOANH · THÔNG TIN</p>
    <h1>@ViewData["Title"]</h1>
    <div class="panel editorial">
        <p>@ViewData["Text"]</p>
        <hr/>
        <h2>Kết nối với cửa hàng</h2>
        <p>
            @Model.Name
            <br/>
            @Model.Address
            <br/>
            @Model.Phone
            <br/>
            @Model.Email
        </p>
        <a href="/Shop" class="btn-black">Tiếp tục khám phá</a>
    </div>
</section>

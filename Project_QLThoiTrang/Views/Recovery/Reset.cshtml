@model ResetInput
@{ViewData["Title"]="Đặt lại mật khẩu";}
<section class="page-section narrow"><h1>Đặt lại mật khẩu</h1><form method="post" class="panel form-stack"><div asp-validation-summary="All" class="validation"></div><label>Email<input asp-for="Email" type="email" autocomplete="email" required/></label><label>Mã OTP<input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required/></label><label>Mật khẩu mới<input asp-for="Password" type="password" autocomplete="new-password" minlength="8" required/></label><label>Nhập lại mật khẩu<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/></label><button class="btn-black">Đặt lại mật khẩu</button><a href="/Recovery/Forgot">Gửi mã mới</a></form></section>

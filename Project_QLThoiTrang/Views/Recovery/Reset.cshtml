@*
    VAI TRÒ VIEW: Mở form nhập email, OTP và mật khẩu mới. DỮ LIỆU MODEL: ResetInput. ĐIỂM XỬ LÝ:
    Controllers/RecoveryController.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model ResetInput
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<section class="page-section narrow">
    <h1>Đặt lại mật khẩu</h1>
    @*
        FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Recovery/Reset. asp-for
        liên kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra ModelState/quyền;
        service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token chống CSRF khi áp
        dụng. CHỨC NĂNG: Kiểm tra mẫu và hoàn tất khôi phục; OTP không hợp lệ/hết hạn/hết số lần thử
        thì trả lại form, thành công chuyển sang đăng nhập.
    *@
    <form method="post" class="panel form-stack">
        @*
            THÔNG BÁO LỖI: Razor hiển thị các lỗi ModelState do binding, DataAnnotations hoặc
            controller thêm; sửa ô bị lỗi rồi gửi lại form.
        *@
        <div asp-validation-summary="All" class="validation"></div>
        <label>
            Email
            <input asp-for="Email" type="email" autocomplete="email" required/>
        </label>
        <label>
            Mã OTP
            <input
                asp-for="Code"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]{6}"
                maxlength="6"
                required
            />
        </label>
        <label>
            Mật khẩu mới
            <input
                asp-for="Password"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
            />
        </label>
        <label>
            Nhập lại mật khẩu
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/>
        </label>
        <button class="btn-black">Đặt lại mật khẩu</button>
        <a href="/Recovery/Forgot">Gửi mã mới</a>
    </form>
</section>

<label>
    Khoảng thời gian
    <select name="period">
        <option value="">Chọn ngày tùy ý</option>
        <option value="today" selected="@(ViewBag.Period == "today")">Hôm nay</option>
        <option value="last7" selected="@(ViewBag.Period == "last7")">7 ngày gần nhất</option>
        <option value="last30" selected="@(ViewBag.Period == "last30")">30 ngày gần nhất</option>
        <option value="month" selected="@(ViewBag.Period == "month")">Tháng này</option>
    </select>
</label>

@*
    VAI TRÒ VIEW: Khung quản trị với điều hướng theo vai trò, thông báo và vùng RenderBody. Hiển thị
    menu theo quyền không thay thế bộ lọc quyền trong AdminExtensions. Partial/layout được trang cha
    gọi; không tự tạo URL/action riêng.
*@

@using Project_QLThoiTrang.Services
@inject StoreService Store
@{
    var name = Store.Read(d => d.Settings.Name);
}
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>@ViewData["Title"] · Quản trị @name</title>
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/screens.css" asp-append-version="true"/>
    </head>
    <body class="admin-body">
        <div class="admin-shell">
            <aside class="admin-sidebar">
                <a href="/Admin" class="logo">
                    @name
                    <span>STORE WORKSPACE</span>
                </a>
                @*
                    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_AdminNavigation.cshtml. Các liên kết quản
                    trị theo vai trò; mỗi href trỏ tới controller/action tương ứng. Thêm mục menu
                    không tự cấp quyền server.
                *@
                <partial name="_AdminNavigation"/>
                <div class="sidebar-bottom">
                    <span>SQL SERVER · QOANH</span>
                    <a href="/">Xem cửa hàng →</a>
                </div>
            </aside>
            <div class="admin-main">
                <header class="admin-header">
                    <div>
                        <strong>Không gian quản lý</strong>
                        <span>Thời trang / @ViewData["Title"]</span>
                    </div>
                    <div class="actions">
                        <a href="/Account" class="button-secondary compact">@User.Identity?.Name</a>
                        @*
                            FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới
                            /Account/Logout. Controller nhận dữ liệu và kiểm tra ModelState/quyền;
                            service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token
                            chống CSRF khi áp dụng. CHỨC NĂNG: Nhận POST của tài khoản đã đăng nhập:
                            ghi thời điểm đăng xuất, xóa Session và cookie rồi quay về trang chủ.Các
                            thuộc tính data-* nối form với sự kiện JavaScript trong wwwroot/js.
                        *@
                        <form
                            asp-controller="Account"
                            asp-action="Logout"
                            method="post"
                            data-confirm="Bạn có chắc muốn đăng xuất không?"
                        >
                            <button class="button-secondary compact">Đăng xuất</button>
                        </form>
                    </div>
                </header>
                <main class="admin-content">
                    @*
                        THÀNH PHẦN DÙNG CHUNG: Views/Shared/_Messages.cshtml. Hiển thị TempData
                        Success/Error sau chuyển hướng; dữ liệu lỗi/thành công do controller đặt,
                        không tự thay đổi database.
                    *@
                    <partial name="_Messages"/>
                    <div class="page-heading">
                        <div>
                            <p class="eyebrow">QOANH / QUẢN TRỊ</p>
                            <h1>@ViewData["Title"]</h1>
                        </div>
                    </div>
                    @RenderBody()
                </main>
                <footer class="admin-footer">QOANH · Quản lý cửa hàng thời trang</footer>
            </div>
        </div>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>

@using Project_QLThoiTrang.Services
@inject StoreService Store
@{var name=Store.Read(d=>d.Settings.Name);var current=ViewContext.RouteData.Values["action"]?.ToString();}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Quản trị @name</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/screens.css" asp-append-version="true"/></head><body class="admin-body"><div class="admin-shell"><aside class="admin-sidebar"><a href="/Admin" class="logo">@name<span>STORE WORKSPACE</span></a><nav aria-label="Quản trị">@foreach(var item in new[]{("Index","Tổng quan"),("Products","Sản phẩm"),("Categories","Danh mục"),("Orders","Đơn hàng"),("Customers","Khách hàng"),("Inventory","Tồn kho"),("Promotions","Khuyến mãi"),("Reports","Báo cáo"),("Settings","Cài đặt")}){<a class="@(current==item.Item1?"active":"")" href="/Admin/@item.Item1">@item.Item2</a>}</nav><div class="sidebar-bottom"><span>BẢN DEMO · LƯU JSON</span><a href="/">Xem cửa hàng →</a></div></aside><div class="admin-main"><header class="admin-header"><div><strong>Không gian quản lý</strong><span>Thời trang / @ViewData["Title"]</span></div><div class="actions"><a href="/Account" class="button-secondary compact">@User.Identity?.Name</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="button-secondary compact">Đăng xuất</button></form></div></header><main class="admin-content"><partial name="_Messages"/><div class="page-heading"><div><p class="eyebrow">QOANH / QUẢN TRỊ</p><h1>@ViewData["Title"]</h1></div></div>@RenderBody()</main><footer class="admin-footer">Bản demo · Không giao dịch thanh toán thật · Dữ liệu lưu trên máy chạy web.</footer></div></div><script src="~/js/site.js" asp-append-version="true"></script></body></html>


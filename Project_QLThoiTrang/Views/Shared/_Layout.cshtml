@*
    VAI TRÒ VIEW: Khung chung cửa hàng: header, menu, ô tìm kiếm, giỏ/yêu thích, RenderBody và
    footer. Các trang con chỉ thay vùng RenderBody; script/CSS dùng chung được nạp ở đây.
    Partial/layout được trang cha gọi; không tự tạo URL/action riêng.
*@

@using Project_QLThoiTrang.Services
@inject StoreService Store
@{
    var settings = Store.Read(d => d.Settings);
    var cart = SessionStore.Get<List<CartItem>>(Context.Session, "cart");
}
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>@ViewData["Title"] · @settings.Name</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/screens.css" asp-append-version="true"/>
    </head>
    <body class="storefront-body">
        <div class="demo-strip">QOANH - Thời trang mỗi ngày</div>
        <header class="main-header">
            <div class="header-left">
                <a href="/" class="logo">@settings.Name</a>
                <nav class="main-menu" aria-label="Danh mục">
                    <a href="/Shop?category=Nữ">NỮ</a>
                    <a href="/Shop?category=Nam">NAM</a>
                    <a href="/Shop?category=Trẻ%20em">TRẺ EM</a>
                    <a href="/Shop?collection=new">HÀNG MỚI</a>
                    <a href="/Shop?collection=sale">ƯU ĐÃI</a>
                </nav>
            </div>
            <div class="header-right">
                @*
                    ĐIỀU KIỆN HIỂN THỊ: phần bên dưới chỉ xuất hiện khi trạng thái đăng nhập/vai trò
                    thỏa biểu thức if. Quyền thực hiện thao tác vẫn phải được controller/service
                    kiểm tra.
                *@
                @if (User.IsInRole("Customer"))
                {
                    <a
                        href="/Chat"
                        class="text-link header-support"
                        aria-label="Chat hỗ trợ"
                        title="Chat hỗ trợ"
                    >
                        <i class="bi bi-headset" aria-hidden="true"></i>
                        <span>Chat hỗ trợ</span>
                    </a>
                }
                @*
                    FORM GET: gửi các ô input/select/textarea theo thuộc tính name tới /Shop. Các
                    giá trị được gửi trong query string để đọc/lọc dữ liệu.
                *@
                <form action="/Shop" method="get" class="search-box">
                    <label class="sr-only" for="header-search">Tìm sản phẩm</label>
                    <input
                        id="header-search"
                        type="search"
                        name="q"
                        placeholder="Tìm kiếm sản phẩm"
                    />
                    <button type="submit" aria-label="Tìm kiếm" class="search-submit">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </button>
                </form>
                <div class="header-actions">
                    <a href="/Account" class="header-icon" aria-label="Tài khoản">
                        <i class="bi bi-person" aria-hidden="true"></i>
                    </a>
                    <a href="/Shop/Wishlist" class="header-icon" aria-label="Yêu thích">
                        <i class="bi bi-heart" aria-hidden="true"></i>
                    </a>
                    @*
                        ĐIỀU KIỆN HIỂN THỊ: phần bên dưới chỉ xuất hiện khi trạng thái đăng nhập/vai
                        trò thỏa biểu thức if. Quyền thực hiện thao tác vẫn phải được
                        controller/service kiểm tra.
                    *@
                    @if (User.Identity?.IsAuthenticated != true || User.IsInRole("Customer"))
                    {
                        <a href="/Shop/Cart" class="header-icon cart-icon" aria-label="Giỏ hàng">
                            <i class="bi bi-bag" aria-hidden="true"></i>
                            <span>@cart.Sum(i => i.Quantity)</span>
                        </a>
                    }
                    @*
                        ĐIỀU KIỆN HIỂN THỊ: phần bên dưới chỉ xuất hiện khi trạng thái đăng nhập/vai
                        trò thỏa biểu thức if. Quyền thực hiện thao tác vẫn phải được
                        controller/service kiểm tra.
                    *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @*
                            FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới
                            /Account/Logout. Controller nhận dữ liệu và kiểm tra ModelState/quyền;
                            service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo token
                            chống CSRF khi áp dụng. CHỨC NĂNG: Nhận POST của tài khoản đã đăng nhập:
                            ghi thời điểm đăng xuất, xóa Session và cookie rồi quay về trang chủ.Các
                            thuộc tính data-* nối form với sự kiện JavaScript trong wwwroot/js.
                        *@
                        <form
                            asp-controller="Account"
                            asp-action="Logout"
                            method="post"
                            class="header-logout"
                            data-confirm="Bạn có chắc muốn đăng xuất không?"
                        >
                            <button
                                type="submit"
                                class="header-icon"
                                aria-label="Đăng xuất"
                                title="Đăng xuất"
                            >
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </header>
        <main id="main-content">
            @*
                THÀNH PHẦN DÙNG CHUNG: Views/Shared/_Messages.cshtml. Hiển thị TempData
                Success/Error sau chuyển hướng; dữ liệu lỗi/thành công do controller đặt, không tự
                thay đổi database.
            *@
            <partial name="_Messages"/>
            @RenderBody()
        </main>
        <footer class="footer">
            <div class="footer-container">
                <div>
                    <h3>@settings.Name</h3>
                    <p>Đơn giản, tinh tế và thoải mái mỗi ngày.</p>
                    <p>
                        @settings.Phone
                        <br/>
                        @settings.Email
                    </p>
                </div>
                <div>
                    <h4>HỖ TRỢ</h4>
                    <a href="/Home/Info/contact">Liên hệ</a>
                    <a href="/Home/Info/returns">Đổi trả</a>
                    <a href="/Home/Info/guide">Hướng dẫn mua hàng</a>
                </div>
                <div>
                    <h4>THÔNG TIN</h4>
                    <a href="/Home/Info/about">Về chúng tôi</a>
                    <a href="/Home/Info/stores">Cửa hàng</a>
                    <a href="/Home/Info/privacy">Quyền riêng tư</a>
                    <a href="/Home/Info/terms">Điều khoản</a>
                </div>
                <div>
                    <h4>KHÔNG GIAN CỦA BẠN</h4>
                    <a href="/Account/Orders">Đơn hàng của tôi</a>
                    <a href="/Shop/Wishlist">Sản phẩm yêu thích</a>
                    <a href="/Admin">Quản trị cửa hàng</a>
                </div>
            </div>
            <div class="copyright">
                © @DateTime.Today.Year @settings.Name · Cửa hàng thời trang QOANH.
            </div>
        </footer>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>

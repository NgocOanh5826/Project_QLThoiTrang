@*
    VAI TRÒ VIEW: Hiển thị TempData Success/Error sau chuyển hướng; dữ liệu lỗi/thành công do
    controller đặt, không tự thay đổi database. Partial/layout được trang cha gọi; không tự tạo
    URL/action riêng.
*@

@if (TempData["Success"] is string success)
{
    <div class="notice success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice error" role="alert">@error</div>
}

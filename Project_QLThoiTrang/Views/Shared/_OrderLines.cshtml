@model Order
<div class="table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Size / màu</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>
                        <div class="table-product">
                            <img src="@line.Image" alt=""/>
                            <span>@line.Name</span>
                        </div>
                    </td>
                    <td>@line.Size / @line.Color</td>
                    <td>@line.Quantity</td>
                    <td>@line.Price.ToString("N0") đ</td>
                    <td>@((line.Price * line.Quantity).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="totals">
    <p>
        Tạm tính
        <strong>@Model.Subtotal.ToString("N0") đ</strong>
    </p>
    <p>
        Giao hàng
        <strong>@Model.Shipping.ToString("N0") đ</strong>
    </p>
    <p>
        Giảm giá (
        @Model.PromotionCode
        )
        <strong>@Model.Discount.ToString("N0") đ</strong>
    </p>
    <p class="total">
        Tổng cộng
        <strong>@Model.Total.ToString("N0") đ</strong>
    </p>
</div>

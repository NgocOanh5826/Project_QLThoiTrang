@*
    VAI TRÒ VIEW: Hiển thị trạng thái tiền đã thu/hoàn và hướng dẫn liên quan; Admin/Payment mới là
    điểm nhận thao tác ghi nhận thu tiền. DỮ LIỆU MODEL: Order. Partial/layout được trang cha gọi;
    không tự tạo URL/action riêng.
*@

@model Order
<section class="panel form-stack">
    <h2>Thanh toán · @(Model.Payment == "Chuyển khoản" ? "Chuyển khoản" : "COD")</h2>
    <p>@Model.PaymentStatus</p>
    <p>
        Đã nhận: @Model.PaidAmount.ToString("N0") đ · Đã hoàn: @Model.RefundedAmount.ToString("N0")
        đ
    </p>
    @*
        THÀNH PHẦN DÙNG CHUNG: Views/Shared/_BankInstructions.cshtml. Hướng dẫn chuyển khoản bằng
        ảnh QR và nội dung đã chụp trên đơn; hiển thị hướng dẫn không đồng nghĩa đã ghi nhận thanh
        toán.
    *@
    <partial name="_BankInstructions" model="Model"/>
    @if ((User.IsInRole("Admin") || User.IsInRole("Sales")) && Model.PaidAmount < Model.Total && ((
        Model.Payment == "Chuyển khoản" && Model.Status == "Chờ xác nhận") || new[]
    {
        "Đã xác nhận",
        "Đang chuẩn bị",
        "Đang giao",
        "Đã giao",
        "Hoàn thành"
    }.Contains(Model.Status)))
    {
        @*
            FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Admin/Payment.
            Controller nhận dữ liệu và kiểm tra ModelState/quyền; service kiểm tra nghiệp vụ trước
            khi lưu. TagHelper form POST tạo token chống CSRF khi áp dụng. CHỨC NĂNG: Ghi nhận khoản
            tiền đã thu cho đơn; RecordPayment kiểm tra đúng số còn thu, trạng thái đơn và mã biên
            nhận chưa trùng.Các thuộc tính data-* nối form với sự kiện JavaScript trong wwwroot/js.
        *@
        <form
            asp-controller="Admin"
            asp-action="Payment"
            method="post"
            class="form-stack"
            data-confirm="Xác nhận đã thực nhận đủ tiền và đối soát chứng từ?"
        >
            <input name="id" type="hidden" value="@Model.Id"/>
            <label>
                Số tiền đã nhận
                <input
                    name="amount"
                    type="number"
                    value="@((Model.Total - Model.PaidAmount)
                    .ToString(System.Globalization.CultureInfo.InvariantCulture))"
                    readonly
                />
            </label>
            <label>
                Mã giao dịch / biên nhận duy nhất
                <input name="reference" maxlength="100" required/>
            </label>
            <p class="notice">
                Chỉ xác nhận theo tiền đã thực nhận. Việc khách quét QR hoặc báo đã chuyển không tự
                xác nhận thanh toán.
            </p>
            <button class="btn-black">Xác nhận đã nhận đủ tiền</button>
        </form>
    }
</section>

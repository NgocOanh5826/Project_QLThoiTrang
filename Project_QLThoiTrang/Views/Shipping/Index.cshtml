@*
    VAI TRÒ VIEW: Admin/Sales mở thông tin gửi hàng của đơn, trạng thái cấu hình GHN và vận đơn đã
    lưu nếu có; id không tồn tại trả 404. DỮ LIỆU MODEL: ShipmentInput. ĐIỂM XỬ LÝ:
    Controllers/ShippingController.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model ShipmentInput
@{
    ViewData["Title"] = "Vận đơn GHN";
    var order = (Order)ViewBag.Order;
    var shipment = (Shipment? )ViewBag.Shipment;
}
<div class="actions toolbar-actions">
    <a href="/Admin/Order/@order.Id" class="button-secondary">Quay lại đơn hàng</a>
</div>
<div class="panel form-stack">
    <h2>@order.Id</h2>
    <p>
        @order.Name
        ·
        @order.Phone
        <br/>
        @order.Address
    </p>
    @if (shipment != null)
    {
        <p>Mã vận đơn: @(shipment.TrackingCode ?? "Chưa xác định") · @shipment.Status</p>
        <p>@shipment.Error</p>
        @*
            FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Shipping/Sync.
            asp-for liên kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra
            ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo
            token chống CSRF khi áp dụng. CHỨC NĂNG: Lấy lại trạng thái vận đơn bằng mã đơn đã gửi
            qua ShippingService.Sync; cập nhật kết quả trong SQL rồi quay lại trang vận chuyển.
        *@
        <form asp-action="Sync" method="post">
            <input name="id" value="@order.Id" type="hidden"/>
            <button class="button-secondary" disabled="@(ViewBag.Ready != true)">
                Đồng bộ trạng thái từ GHN
            </button>
        </form>
    }
    @if (ViewBag.Ready != true)
    {
        <p class="notice">
            GHN chưa cấu hình tài khoản kết nối. Cửa hàng cần bổ sung Token và ShopId để sử dụng.
        </p>
    }
    @if (shipment?.TrackingCode == null)
    {
        @*
            FORM POST: gửi các ô input/select/textarea theo thuộc tính name tới /Shipping/Create.
            asp-for liên kết tên ô với thuộc tính model. Controller nhận dữ liệu và kiểm tra
            ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu. TagHelper form POST tạo
            token chống CSRF khi áp dụng. CHỨC NĂNG: Nhận tỉnh/phường, khối lượng và kích thước;
            ShippingService.Create kiểm tra điều kiện rồi gửi GHN. Lỗi mạng/kết quả chưa rõ yêu cầu
            đối soát trước khi thử lại.Các thuộc tính data-* nối form với sự kiện JavaScript trong
            wwwroot/js.
        *@
        <form
            asp-action="Create"
            method="post"
            class="form-stack"
            data-confirm="Xác nhận gửi thông tin đơn và người nhận sang GHN để tạo vận đơn?"
        >
            <input asp-for="Id" type="hidden"/>
            <label>
                Tỉnh/thành theo danh mục GHN mới
                <input asp-for="Province" maxlength="100" required/>
            </label>
            <label>
                Phường/xã theo danh mục GHN mới
                <input asp-for="Ward" maxlength="100" required/>
            </label>
            <div class="form-grid">
                <label>
                    Khối lượng (gram, dưới 20 kg)
                    <input asp-for="Weight" type="number" min="1" max="19999" required/>
                </label>
                <label>
                    Dài (cm)
                    <input asp-for="Length" type="number" min="1" max="200" required/>
                </label>
                <label>
                    Rộng (cm)
                    <input asp-for="Width" type="number" min="1" max="200" required/>
                </label>
                <label>
                    Cao (cm)
                    <input asp-for="Height" type="number" min="1" max="200" required/>
                </label>
            </div>
            <p class="notice">
                Shop trả phí GHN. Phí đã báo khách trên đơn được giữ nguyên. COD chỉ thu phần tiền
                đơn còn thiếu; trạng thái giao hàng không tự xác nhận tiền đã về cửa hàng. Nếu chưa
                rõ kết quả, đối soát trước khi gửi lại cùng nội dung.
            </p>
            <button class="btn-black" disabled="@(ViewBag.Ready != true)">Tạo vận đơn</button>
        </form>
    }
</div>

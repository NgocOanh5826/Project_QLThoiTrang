@*
    VAI TRÒ VIEW: Dựng giỏ từ Session và giá/biến thể hiện tại trên server bằng SessionStore.Cart;
    ShoppingSession chặn tài khoản nhân viên mua hàng. DỮ LIỆU MODEL: CartViewModel. ĐIỂM XỬ LÝ:
    Controllers/ShopController.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model CartViewModel
@inject Project_QLThoiTrang.Services.StoreService Store
@{
    ViewData["Title"] = "Giỏ hàng";
    var products = Store.Read(d => d.Products);
}
<section class="page-section cart-page">
    <p class="eyebrow">01 GIỎ HÀNG / 02 GIAO HÀNG / 03 HOÀN TẤT</p>
    <h1>Giỏ hàng của bạn</h1>
    @if (Model.Lines.Count == 0)
    {
        <div class="empty-state">
            <h2>Giỏ hàng đang trống</h2>
            <p>Bắt đầu với một món đồ bạn thật sự yêu thích.</p>
            <a href="/Shop" class="btn-black">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="checkout-grid">
            <div class="panel">
                @foreach (var line in Model.Lines)
                {
                    var variants = products.FirstOrDefault(p => p.Id == line.ProductId && p.Active)
                    ?.Variants.Where(v => v.Active).ToList() ?? new List<Variant>();
                    var stock = variants.FirstOrDefault(v => v.Id == line.VariantId)?.Stock ?? 0;
                    <div class="cart-line">
                        <a asp-action="Detail" asp-route-id="@line.ProductId">
                            <img src="@line.Image" alt="@line.Name"/>
                        </a>
                        <div>
                            <h3>
                                <a asp-action="Detail" asp-route-id="@line.ProductId">@line.Name</a>
                            </h3>
                            <p class="muted">Đơn giá: @line.Price.ToString("N0") đ</p>
                            <div class="cart-controls">
                                @*
                                    FORM POST: gửi các ô input/select/textarea theo thuộc tính name
                                    tới /Shop/UpdateCart. Controller nhận dữ liệu và kiểm tra
                                    ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu.
                                    TagHelper form POST tạo token chống CSRF khi áp dụng. CHỨC NĂNG:
                                    Sửa màu/size/số lượng hoặc xóa dòng giỏ. remove = true hoặc
                                    quantity = 0 thì Remove; khi đổi biến thể trùng dòng khác thì
                                    gộp lượng. Kiểm tra tổng gộp không vượt 20/tồn trước khi lưu
                                    Session.Các thuộc tính data-* nối form với sự kiện JavaScript
                                    trong wwwroot/js.
                                *@
                                <form
                                    asp-action="UpdateCart"
                                    method="post"
                                    class="cart-edit-controls"
                                    data-cart-edit
                                    data-variants="@(
                                        System.Text.Json.JsonSerializer.Serialize(
                                            variants.Select(v => new
                                            {
                                                id = v.Id,
                                                color = v.Color,
                                                size = v.Size,
                                                stock = v.Stock
                                            })
                                        )
                                    )"
                                >
                                    <input type="hidden" name="id" value="@line.ProductId"/>
                                    <input type="hidden" name="variantId" value="@line.VariantId"/>
                                    <label>
                                        Màu sắc
                                        <select data-cart-color>
                                            @foreach (var color in variants.Select(v => v.Color)
                                                .Append(line.Color).Distinct())
                                            {
                                                <option
                                                    selected="@(color == line.Color)"
                                                    value="@color"
                                                >@color</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        Kích cỡ
                                        <select name="newVariantId" data-cart-size>
                                            @foreach (var v in variants.Where(v => v.Color == line
                                                .Color))
                                            {
                                                <option
                                                    value="@v.Id"
                                                    selected="@(v.Id == line.VariantId)"
                                                    disabled="@(v.Stock <= 0)"
                                                >@v.Size@(v.Stock <= 0 ? " (hết hàng)" : "")</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="cart-quantity">
                                        Số lượng
                                        <input
                                            type="number"
                                            name="quantity"
                                            value="@line.Quantity"
                                            min="1"
                                            max="@Math.Max(line.Quantity, Math.Min(20, stock))"
                                            required
                                        />
                                    </label>
                                    <noscript>
                                        <button type="submit" class="button-secondary">
                                            Lưu giỏ hàng
                                        </button>
                                    </noscript>
                                </form>
                                @*
                                    FORM POST: gửi các ô input/select/textarea theo thuộc tính name
                                    tới /Shop/UpdateCart. Controller nhận dữ liệu và kiểm tra
                                    ModelState/quyền; service kiểm tra nghiệp vụ trước khi lưu.
                                    TagHelper form POST tạo token chống CSRF khi áp dụng. CHỨC NĂNG:
                                    Sửa màu/size/số lượng hoặc xóa dòng giỏ. remove = true hoặc
                                    quantity = 0 thì Remove; khi đổi biến thể trùng dòng khác thì
                                    gộp lượng. Kiểm tra tổng gộp không vượt 20/tồn trước khi lưu
                                    Session.Các thuộc tính data-* nối form với sự kiện JavaScript
                                    trong wwwroot/js.
                                *@
                                <form
                                    asp-action="UpdateCart"
                                    method="post"
                                    class="cart-remove"
                                    data-confirm="Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng không?"
                                >
                                    <input type="hidden" name="id" value="@line.ProductId"/>
                                    <input type="hidden" name="variantId" value="@line.VariantId"/>
                                    <input type="hidden" name="quantity" value="@line.Quantity"/>
                                    <button
                                        name="remove"
                                        value="true"
                                        type="submit"
                                        class="text-button"
                                    >Xóa</button>
                                </form>
                            </div>
                        </div>
                        <strong>@((line.Quantity * line.Price).ToString("N0")) đ</strong>
                    </div>
                }
                <p class="muted small" data-cart-save-status aria-live="polite">
                    Thay đổi màu, kích cỡ hoặc số lượng để tự động lưu giỏ hàng.
                </p>
                <a href="/Shop" class="text-link">Tiếp tục mua sắm →</a>
            </div>
            <aside class="panel order-summary cart-order-summary">
                <h2>Tóm tắt đơn hàng</h2>
                <div class="totals">
                    <p>
                        Tạm tính
                        <strong>@Model.Subtotal.ToString("N0") đ</strong>
                    </p>
                    <p>
                        Giao hàng
                        <strong>@Model.Shipping.ToString("N0") đ</strong>
                    </p>
                    <p class="total">
                        Tổng cộng
                        <strong>@Model.Total.ToString("N0") đ</strong>
                    </p>
                </div>
                <a href="/Shop/Checkout" class="btn-black full-width">Tiến hành đặt hàng</a>
                <p class="muted small">
                    Miễn phí giao hàng từ 700.000 đ. Chọn COD hoặc chuyển khoản ở bước thanh toán.
                </p>
            </aside>
        </div>
    }
</section>

@model CartViewModel
@{ViewData["Title"]="Giỏ hàng";}
<section class="page-section"><p class="eyebrow">01 GIỎ HÀNG / 02 GIAO HÀNG / 03 HOÀN TẤT</p><h1>Giỏ hàng của bạn</h1>@if(Model.Lines.Count==0){<div class="empty-state"><h2>Giỏ hàng đang trống</h2><p>Bắt đầu với một món đồ bạn thật sự yêu thích.</p><a href="/Shop" class="btn-black">Tiếp tục mua sắm</a></div>}else{<div class="checkout-grid"><div class="panel">@foreach(var line in Model.Lines){<div class="cart-line"><a asp-action="Detail" asp-route-id="@line.ProductId"><img src="@line.Image" alt="@line.Name"/></a><div><h3>@line.Name</h3><p class="muted">Size @line.Size / @line.Color · @line.Price.ToString("N0") đ</p><form asp-action="UpdateCart" method="post" class="inline-form"><input type="hidden" name="id" value="@line.ProductId"/><input type="hidden" name="size" value="@line.Size"/><input type="hidden" name="variantId" value="@line.VariantId"/><label class="sr-only" for="qty-@line.ProductId-@line.Size">Số lượng @line.Name</label><input id="qty-@line.ProductId-@line.Size" type="number" name="quantity" value="@line.Quantity" min="0" max="20"/><button class="button-secondary">Cập nhật</button><button name="remove" value="true" type="submit" class="text-button">Xóa</button></form></div><strong>@((line.Quantity*line.Price).ToString("N0")) đ</strong></div>}<a href="/Shop" class="text-link">Tiếp tục mua sắm →</a></div><aside class="panel order-summary"><h2>Tóm tắt đơn hàng</h2><div class="totals"><p>Tạm tính<strong>@Model.Subtotal.ToString("N0") đ</strong></p><p>Giao hàng<strong>@Model.Shipping.ToString("N0") đ</strong></p><p class="total">Tổng cộng<strong>@Model.Total.ToString("N0") đ</strong></p></div><a href="/Shop/Checkout" class="btn-black full-width">Tiến hành đặt hàng</a><p class="muted small">Miễn phí giao hàng từ 700.000 đ. Đơn hàng demo, không thu tiền trực tuyến.</p></aside></div>}</section>


@model CheckoutInput
@{ViewData["Title"]="Thông tin giao hàng";var cart=(CartViewModel)ViewBag.Cart;}
<section class="page-section"><p class="eyebrow">01 GIỎ HÀNG / 02 GIAO HÀNG / 03 HOÀN TẤT</p><h1>Thông tin giao hàng</h1><div class="checkout-grid"><form asp-action="Checkout" method="post" class="panel form-stack"><h2>Địa chỉ nhận hàng</h2><div asp-validation-summary="All" class="validation"></div><label>Họ và tên<input asp-for="Name" autocomplete="name"/></label><label>Số điện thoại<input asp-for="Phone" autocomplete="tel"/></label><div class="address-picker" data-address-picker><input asp-for="Address" type="hidden" data-address-full/><div class="form-grid address-grid"><label>Tỉnh/Thành phố<select data-address-province required><option value="">Chọn tỉnh/thành phố</option></select></label><label>Xã/Phường<select data-address-ward required disabled><option value="">Chọn xã/phường</option></select></label></div><label>Số nhà, tên đường<input type="text" data-address-street placeholder="Ví dụ: 96 Võ Văn Ngân" autocomplete="street-address" required/></label></div><label>Ghi chú đơn hàng<textarea asp-for="Note"></textarea></label><div class="notice">Thanh toán khi nhận hàng · Đặt hàng thử nghiệm, không thanh toán thật.</div><button class="btn-black">Xác nhận đặt hàng demo</button><a href="/Shop/Cart" class="text-button">Quay lại giỏ hàng</a></form><aside class="panel order-summary"><h2>Đơn hàng của bạn</h2>@foreach(var line in cart.Lines){<p class="summary-line"><span>@line.Name · @line.Size × @line.Quantity</span><strong>@((line.Price*line.Quantity).ToString("N0")) đ</strong></p>}<div class="totals"><p>Tạm tính<strong>@cart.Subtotal.ToString("N0") đ</strong></p><p>Giao hàng<strong>@cart.Shipping.ToString("N0") đ</strong></p><p class="total">Tổng cộng<strong>@cart.Total.ToString("N0") đ</strong></p></div></aside></div></section>

@model Product
@{
	ViewData["Title"] = Model.Name;
}
<section class="page-section"><p class="breadcrumb"><a href="/">Trang chủ</a> / <a href="/Shop">Sản phẩm</a> / @Model.Name</p><div class="detail-grid"><div class="detail-image"><img src="@Model.Image" alt="@Model.Name" /></div><div class="detail-copy"><p class="eyebrow">@Model.Category · EVERYDAY ESSENTIALS</p><h1>@Model.Name</h1><p class="detail-price">@Model.Price.ToString("N0") đ</p><p class="muted">@Model.Description</p><p>Màu sắc: <strong>@Model.Color</strong></p><form asp-action="Add" method="post" class="form-stack"><input type="hidden" name="id" value="@Model.Id" /><fieldset><legend>Chọn kích cỡ</legend><div class="size-options">@foreach(var size in new[]{"S","M","L","XL"}){
<label><input type="radio" name="size" value="@size" checked="@(size == "M")" /><span>@size</span></label>
}
</div></fieldset><label>Số lượng<input type="number" name="quantity" value="1" min="1" max="@Math.Min(20, Model.Stock)" disabled="@(Model.Stock == 0)" /></label><button class="btn-black full-width" disabled="@(Model.Stock == 0)">@(Model.Stock > 0 ? "Thêm vào giỏ hàng" : "Tạm hết hàng")</button><p class="muted small">Còn @Model.Stock sản phẩm · Tồn kho tổng cho các kích cỡ</p></form><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><button class="button-secondary">Thêm / bỏ yêu thích</button></form><details><summary>Chất liệu & chăm sóc</summary><p>Giặt nhẹ với màu tương tự. Phơi nơi thoáng mát, tránh ánh nắng trực tiếp.</p></details><details><summary>Giao hàng & đổi trả</summary><p>Phí giao hàng demo 30.000 đ; miễn phí từ 700.000 đ. <a href="/Home/Info/returns">Xem chính sách đổi trả.</a></p></details></div></div><div class="section-title related-heading"><h2>Có thể bạn cũng thích</h2><a href="/Shop">Xem thêm →</a></div><div class="product-grid">@foreach(var related in (List<Product>)ViewBag.Related){
<partial name="_ProductCard" model="related" />
}
</div></section>

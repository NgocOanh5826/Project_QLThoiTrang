@model CatalogViewModel
@{ViewData["Title"]=Model.Collection=="new"?"Hàng mới về":Model.Collection=="sale"?"Sản phẩm ưu đãi":Model.Category??"Tất cả sản phẩm";}
<section class="page-section"><div class="page-heading"><div><p class="eyebrow">BỘ SƯU TẬP QOANH</p><h1>@ViewData["Title"]</h1><p class="muted">Những món đồ cho phong cách mỗi ngày của bạn.</p></div><span class="count-pill">@Model.Products.Count sản phẩm</span></div>
<form method="get" class="filter-bar"><input type="hidden" name="collection" value="@Model.Collection"/><label>Tìm sản phẩm<input name="q" value="@Model.Query" placeholder="Tên sản phẩm hoặc màu sắc"/></label><label>Danh mục<select name="category"><option value="">Tất cả danh mục</option>@foreach(var category in Model.Categories){<option value="@category" selected="@(Model.Category==category)">@category</option>}</select></label><label>Sắp xếp<select name="sort"><option value="new" selected="@(Model.Sort=="new")">Mới nhất</option><option value="price-asc" selected="@(Model.Sort=="price-asc")">Giá tăng dần</option><option value="price-desc" selected="@(Model.Sort=="price-desc")">Giá giảm dần</option><option value="name" selected="@(Model.Sort=="name")">Tên A–Z</option></select></label><button class="btn-black">Áp dụng</button><a href="/Shop" class="button-secondary">Đặt lại</a></form>
@if(Model.Products.Count==0){<div class="empty-state"><h2>Chưa tìm thấy sản phẩm</h2><p>Thử từ khóa hoặc danh mục khác.</p><a href="/Shop" class="btn-black">Xem toàn bộ sản phẩm</a></div>}else{<div class="product-grid">@foreach(var product in Model.Products){<partial name="_ProductCard" model="product"/>}</div>}
</section>

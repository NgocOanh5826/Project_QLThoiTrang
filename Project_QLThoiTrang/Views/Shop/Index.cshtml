@*
    VAI TRÒ VIEW: Lọc sản phẩm đang bán theo từ khóa tên/màu, danh mục, bộ sưu tập mới/ưu đãi và thứ
    tự giá/tên/mã; đóng gói CatalogViewModel cho view. DỮ LIỆU MODEL: CatalogViewModel. ĐIỂM XỬ LÝ:
    Controllers/ShopController.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model CatalogViewModel
@{
    ViewData["Title"] = Model.Collection == "new" ? "Hàng mới về" : Model.Collection == "sale"
    ? "Sản phẩm ưu đãi" : Model.Category ?? "Tất cả sản phẩm";
}
<section class="page-section" data-catalog>
    <div class="page-heading">
        <div>
            <p class="eyebrow">BỘ SƯU TẬP QOANH</p>
            <h1>@ViewData["Title"]</h1>
            <p class="muted">Những món đồ cho phong cách mỗi ngày của bạn.</p>
        </div>
        <span class="count-pill">@Model.Products.Count sản phẩm</span>
    </div>
    @*
        FORM GET: gửi các ô input/select/textarea theo thuộc tính name tới /Shop/Index. Các giá trị
        được gửi trong query string để đọc/lọc dữ liệu. CHỨC NĂNG: Lọc sản phẩm đang bán theo từ
        khóa tên/màu, danh mục, bộ sưu tập mới/ưu đãi và thứ tự giá/tên/mã; đóng gói
        CatalogViewModel cho view.Các thuộc tính data-* nối form với sự kiện JavaScript trong
        wwwroot/js.
    *@
    <form method="get" class="filter-bar" data-catalog-filter>
        <input type="hidden" name="collection" value="@Model.Collection"/>
        <label>
            Tìm sản phẩm
            <input name="q" value="@Model.Query" placeholder="Tên sản phẩm hoặc màu sắc"/>
        </label>
        <div class="filter-field">
            <span id="category-label">Danh mục</span>
            <select name="category" aria-labelledby="category-label" data-filter-select>
                <option value="">Tất cả danh mục</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(Model.Category == category)">
                        @category
                    </option>
                }
            </select>
        </div>
        <div class="filter-field">
            <span id="sort-label">Sắp xếp</span>
            <select name="sort" aria-labelledby="sort-label" data-filter-select>
                <option value="new" selected="@(Model.Sort == "new")">Mới nhất</option>
                <option value="price-asc" selected="@(Model.Sort == "price-asc")">
                    Giá tăng dần
                </option>
                <option value="price-desc" selected="@(Model.Sort == "price-desc")">
                    Giá giảm dần
                </option>
                <option value="name" selected="@(Model.Sort == "name")">Tên A–Z</option>
            </select>
        </div>
        <a href="/Shop" class="button-secondary">Đặt lại</a>
    </form>
    <div data-catalog-results aria-live="polite" aria-atomic="true">
        @if (Model.Products.Count == 0)
        {
            <div class="empty-state">
                <h2>Chưa tìm thấy sản phẩm</h2>
                <p>Thử từ khóa hoặc danh mục khác.</p>
                <a href="/Shop" class="btn-black">Xem toàn bộ sản phẩm</a>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model.Products)
                {
                    @*
                        THÀNH PHẦN DÙNG CHUNG: Views/Shared/_ProductCard.cshtml. Thẻ sản phẩm trong
                        danh sách: liên kết mở Shop/Detail, hiển thị ảnh/giá và gửi yêu thích. Model
                        là sản phẩm đã được controller lọc.
                    *@
                    <partial name="_ProductCard" model="product"/>
                }
            </div>
        }
    </div>
</section>

@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}
<section class="page-section">
    <div class="page-heading">
        <div>
            <p class="eyebrow">BỘ SƯU TẬP CỦA BẠN</p>
            <h1>Danh sách yêu thích</h1>
        </div>
        <span class="count-pill">@Model.Count sản phẩm</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>Lưu những món đồ bạn thích</h2>
            <p>Nhấn nút trái tim trên sản phẩm để xem lại tại đây.</p>
            <a href="/Shop" class="btn-black">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {

                <partial name="_ProductCard" model="product"/>
            }
        </div>
    }
</section>

@*
    VAI TRÒ VIEW: Hiển thị sản phẩm đang hoạt động trong danh sách yêu thích ở Session; khách đăng
    nhập được nạp danh sách SQL trước action bởi ShoppingSession. DỮ LIỆU MODEL: List<Product>. ĐIỂM
    XỬ LÝ: Controllers/ShopController.cs; tra HUONG_DAN_CODE.md để tìm đúng overload GET/POST.
*@

@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}
<section class="page-section">
    <div class="page-heading">
        <div>
            <p class="eyebrow">BỘ SƯU TẬP CỦA BẠN</p>
            <h1>Danh sách yêu thích</h1>
        </div>
        <span class="count-pill">@Model.Count sản phẩm</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>Lưu những món đồ bạn thích</h2>
            <p>Nhấn nút trái tim trên sản phẩm để xem lại tại đây.</p>
            <a href="/Shop" class="btn-black">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                @*
                    THÀNH PHẦN DÙNG CHUNG: Views/Shared/_ProductCard.cshtml. Thẻ sản phẩm trong danh
                    sách: liên kết mở Shop/Detail, hiển thị ảnh/giá và gửi yêu thích. Model là sản
                    phẩm đã được controller lọc.
                *@
                <partial name="_ProductCard" model="product"/>
            }
        </div>
    }
</section>

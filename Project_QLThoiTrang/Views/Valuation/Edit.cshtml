@model StoreData
@{
    ViewData["Title"] = "Khai báo giá vốn";
    int id = ViewBag.VariantId;
    var v = Model.Variants.Single(v => v.Id == id);
    int quantity = Model.Stocks.Where(s => s.VariantId == id).Sum(s => s.Quantity);
}
<div class="admin-form-page">

    <form
        method="post"
        class="panel form-stack"
        data-confirm="Xác nhận giá vốn theo chứng từ? Chỉ áp dụng giao dịch tiếp theo."
    >
        <h2>@v.Sku · @Model.Products.Single(p => p.Id == v.ProductId).Name</h2>
        <p>Tồn hiện tại: @quantity</p>
        <input name="variantId" value="@id" type="hidden"/>
        <input name="expected" value="@quantity" type="hidden"/>
        <label>
            Giá vốn mỗi sản phẩm
            <input name="cost" type="number" min="0" max="100000000" step="0.01" required/>
        </label>
        <label>
            Căn cứ / chứng từ
            <textarea name="note" minlength="5" maxlength="300" required></textarea>
        </label>
        <div class="actions">
            <button class="btn-black">Ghi giá vốn</button>
            <a href="/Valuation" class="button-secondary">Quay lại</a>
        </div>
    </form>
</div>

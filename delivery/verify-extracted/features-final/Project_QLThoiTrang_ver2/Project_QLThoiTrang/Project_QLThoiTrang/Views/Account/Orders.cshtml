@model List<Order>
@{ViewData["Title"]="Đơn hàng của tôi";}
<section class="page-section"><div class="page-heading"><div><p class="eyebrow">TÀI KHOẢN</p><h1>Đơn hàng của tôi</h1></div><a href="/Account" class="button-secondary">Về tài khoản</a></div>@if(Model.Count==0){<div class="empty-state"><h2>Bạn chưa có đơn hàng</h2><a href="/Shop" class="btn-black">Khám phá cửa hàng</a></div>}else{<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Trạng thái</th><th>Tổng cộng</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td>@order.Id</td><td>@order.Created.ToString("dd/MM/yyyy")</td><td><span class="status">@order.Status</span></td><td>@order.Total.ToString("N0") đ</td><td><a asp-action="Order" asp-route-id="@order.Id" class="button-secondary compact">Xem đơn</a></td></tr>}</tbody></table></div>}</section>

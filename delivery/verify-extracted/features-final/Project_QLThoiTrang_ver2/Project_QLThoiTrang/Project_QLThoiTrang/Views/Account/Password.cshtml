@model PasswordInput
@{ViewData["Title"]="Đổi mật khẩu";}
<section class="page-section"><form method="post" class="panel form-stack"><h1>Đổi mật khẩu</h1><div asp-validation-summary="All" class="validation"></div><label>Mật khẩu hiện tại<input asp-for="CurrentPassword" type="password" required/></label><label>Mật khẩu mới<input asp-for="NewPassword" type="password" minlength="8" required/></label><label>Nhập lại mật khẩu mới<input asp-for="ConfirmPassword" type="password" required/></label><button class="btn-black">Đổi mật khẩu</button></form></section>

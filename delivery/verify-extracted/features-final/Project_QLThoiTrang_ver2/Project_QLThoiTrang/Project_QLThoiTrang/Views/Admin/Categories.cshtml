@model StoreData
@{ViewData["Title"]="Danh mục sản phẩm";ViewData["CreateUrl"]="/Admin/Category";ViewData["CreateLabel"]="Thêm danh mục";}
<partial name="_AdminListToolbar"/><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Danh mục</th><th>Sản phẩm</th><th>Thao tác</th></tr></thead><tbody>@foreach(var category in Model.Categories){<tr><td><strong>@category</strong></td><td>@Model.Products.Count(p=>p.Category==category)</td><td><form asp-action="DeleteCategory" method="post" data-confirm="Xóa danh mục trống này?"><input type="hidden" name="name" value="@category"/><button class="button-danger compact" disabled="@(Model.Products.Any(p=>p.Category==category))">Xóa danh mục</button></form></td></tr>}</tbody></table></div>

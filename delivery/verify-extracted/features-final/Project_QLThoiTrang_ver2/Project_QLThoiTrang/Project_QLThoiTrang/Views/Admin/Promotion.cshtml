@model Promotion
@{ViewData["Title"]="Chương trình ưu đãi";}
<form method="post" class="panel form-stack"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><label>Tên<input asp-for="Name"/></label><label>Mã<input asp-for="Code"/></label><label>Loại giảm<select asp-for="Kind"><option value="PHANTRAM">Phần trăm</option><option value="SOTIEN">Số tiền</option></select></label><label>Giá trị giảm<input asp-for="Value" type="number" min="1" max="100000000" required/></label><label>Đơn tối thiểu<input asp-for="Minimum" type="number" min="0"/></label><label>Giảm tối đa (để trống nếu không giới hạn)<input asp-for="Maximum" type="number" min="0"/></label><label>Số lượt còn lại (để trống nếu không giới hạn)<input asp-for="Remaining" type="number" min="0"/></label><label>Ngày bắt đầu<input asp-for="From" type="date"/></label><label>Ngày kết thúc<input asp-for="Until" type="date"/></label><label class="checkbox"><input asp-for="Active"/>Đang hoạt động</label><fieldset><legend>Sản phẩm áp dụng (không chọn: toàn cửa hàng)</legend>@foreach(var p in (List<Product>)ViewBag.Products){<label class="checkbox"><input name="ProductIds" value="@p.Id" type="checkbox" checked="@Model.ProductIds.Contains(p.Id)"/>@p.Name</label>}</fieldset><button class="btn-black">Lưu ưu đãi</button></form>

@model List<Promotion>
@{ViewData["Title"]="Chương trình khuyến mãi";ViewData["CreateUrl"]="/Admin/Promotion";ViewData["CreateLabel"]="Thêm chương trình";}
<partial name="_AdminListToolbar"/><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Chương trình</th><th>Mã</th><th>Mức giảm dự kiến</th><th>Kết thúc</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td><strong>@p.Code</strong></td><td>@((p.Value>0?p.Value:p.Percent).ToString("N0")) @(p.Kind=="PHANTRAM"?"%":"đ")</td><td>@p.Until.ToString("dd/MM/yyyy")</td><td><span class="status">@(p.Active&&p.Until.Date>=DateTime.Today?"Đang bật":"Ngừng / hết hạn")</span></td><td><a asp-action="Promotion" asp-route-id="@p.Id" class="button-secondary compact">Chỉnh sửa</a></td></tr>}</tbody></table></div>

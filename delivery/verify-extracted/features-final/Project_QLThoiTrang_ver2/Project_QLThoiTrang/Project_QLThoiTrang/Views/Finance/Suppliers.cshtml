@model List<SupplierPayment>
@{ViewData["Title"]="Công nợ nhà cung cấp";var receipts=(List<Project_QLThoiTrang.Data.Native.PhieuNhapRow>)ViewBag.Receipts;var accounts=(List<SupplierAccount>)ViewBag.Accounts;var suppliers=(List<Supplier>)ViewBag.Suppliers;decimal total=accounts.Sum(a=>a.Amount),paid=Model.Sum(p=>p.Amount);}
<div class="metrics"><div class="metric"><span>Phải trả đã đối soát</span><strong>@total.ToString("N0") đ</strong></div><div class="metric"><span>Đã chi</span><strong>@paid.ToString("N0") đ</strong></div><div class="metric"><span>Còn nợ</span><strong>@((total-paid).ToString("N0")) đ</strong></div><div class="metric"><span>Phiếu chưa đối soát</span><strong>@receipts.Count(r=>!accounts.Any(a=>a.ReceiptId==r.MaPhieuNhap))</strong></div></div>
<p class="notice">Phiếu nhập mới ghi số phải trả theo tổng chi tiết. Phiếu lịch sử cần đối soát trước khi ghi chi. Thanh toán nhà cung cấp là ghi nhận chứng từ đã chi bên ngoài hệ thống.</p><partial name="_AdminListToolbar"/>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Nhà cung cấp</th><th>Phiếu</th><th>Ngày nhập</th><th>Phải trả</th><th>Đã chi</th><th>Còn nợ</th><th></th></tr></thead><tbody>@foreach(var p in receipts){var a=accounts.FirstOrDefault(a=>a.ReceiptId==p.MaPhieuNhap);var amount=Model.Where(x=>x.ReceiptId==p.MaPhieuNhap).Sum(x=>x.Amount);<tr><td>@suppliers.FirstOrDefault(s=>s.Id==p.MaNCC)?.Name</td><td>@p.MaPhieuNhap</td><td>@p.NgayNhap.ToString("dd/MM/yyyy")</td><td>@(a?.Amount.ToString("N0")??"Chưa đối soát")</td><td>@amount.ToString("N0")</td><td>@(a==null?"Chưa xác định":(a.Amount-amount).ToString("N0"))</td><td><a href="/Finance/Receipt/@p.MaPhieuNhap" class="button-secondary compact">Đối soát / chi tiền</a></td></tr>}</tbody></table></div>

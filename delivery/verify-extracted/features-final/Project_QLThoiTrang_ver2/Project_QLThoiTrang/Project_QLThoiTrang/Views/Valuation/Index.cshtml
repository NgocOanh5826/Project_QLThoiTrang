@model StoreData
@{ViewData["Title"]="Giá vốn tồn kho";var values=(List<InventoryValue>)ViewBag.Values;}
<p class="notice">Khai báo giá vốn tồn đầu cho từng biến thể theo chứng từ thực tế. Lần nhập tiếp theo cập nhật bình quân theo số lượng tồn và tiền nhập. Khai báo mới chỉ áp dụng giao dịch tiếp theo, không sửa giá vốn đơn đã chốt.</p><partial name="_AdminListToolbar"/>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Biến thể</th><th>Tồn toàn kho</th><th>Giá vốn bình quân</th><th>Căn cứ gần nhất</th><th></th></tr></thead><tbody>@foreach(var v in Model.Variants){var a=values.FirstOrDefault(a=>a.VariantId==v.Id);<tr><td>@Model.Products.Single(p=>p.Id==v.ProductId).Name · @v.Sku</td><td>@Model.Stocks.Where(s=>s.VariantId==v.Id).Sum(s=>s.Quantity)</td><td>@(a?.AverageCost?.ToString("N2")??"Chưa xác định")</td><td>@a?.Note</td><td><a href="/Valuation/Edit/@v.Id" class="button-secondary compact">Khai báo</a></td></tr>}</tbody></table></div>

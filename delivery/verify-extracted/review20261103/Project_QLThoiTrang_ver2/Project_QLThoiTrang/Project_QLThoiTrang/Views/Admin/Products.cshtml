@model List<Product>
@{ViewData["Title"]="Quản lý sản phẩm";}
<form method="get" class="filter-bar"><label>Tìm sản phẩm<input name="q" value="@ViewBag.Query" placeholder="Nhập tên sản phẩm"/></label><button class="btn-black">Tìm kiếm</button><a href="/Admin/Product" class="button-secondary">Thêm sản phẩm</a></form><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><div class="table-product"><img src="@p.Image" alt=""/><div><strong>@p.Name</strong><small>SP@p.Id.ToString("000") · @p.Color</small></div></div></td><td>@p.Category</td><td>@p.Price.ToString("N0") đ</td><td>@p.Stock</td><td><span class="status">@(p.Active?"Đang bán":"Đã ẩn")</span></td><td><div class="actions"><a asp-action="Product" asp-route-id="@p.Id" class="button-secondary compact">Sửa</a><a asp-action="DeleteProduct" asp-route-id="@p.Id" class="button-danger compact">Ẩn</a></div></td></tr>}</tbody></table>@if(Model.Count==0){<p class="empty-state">Không tìm thấy sản phẩm.</p>}</div>

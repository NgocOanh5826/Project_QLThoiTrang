@model StaffInput
@{ViewData["Title"]="Nhân viên và phân quyền";}
<form method="post" class="panel form-stack"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"/><label>Họ tên<input asp-for="Name" required/></label><label>Email<input asp-for="Email" type="email" required/></label><label>Điện thoại<input asp-for="Phone" maxlength="15"/></label><label>Vai trò<select asp-for="Role">@foreach(string r in new[]{"Admin","Catalog","Inventory","Sales","Support"}){<option>@r</option>}</select></label><label>Mật khẩu mới (để trống khi giữ mật khẩu cũ)<input asp-for="Password" type="password" autocomplete="new-password"/></label><label class="checkbox"><input asp-for="Active"/>Đang hoạt động</label><button class="btn-black">Lưu nhân viên</button></form>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Tên</th><th>Email</th><th>Vai trò</th><th>Hoạt động</th><th></th></tr></thead><tbody>@foreach(var c in (List<Customer>)ViewBag.Staff){<tr><td>@c.Name</td><td>@c.Email</td><td>@c.Role</td><td>@c.Active</td><td><a href="/Admin/Staff/@(-c.Id)">Sửa / khóa / đặt lại mật khẩu</a></td></tr>}</tbody></table></div>

@model VariantInput
@{ViewData["Title"]="Biến thể sản phẩm";var products=(List<Product>)ViewBag.Products;}
<form method="post" class="panel form-stack"><input asp-for="Id" type="hidden"/><label>Sản phẩm<select asp-for="ProductId">@foreach(var p in products){<option value="@p.Id">@p.Name</option>}</select></label><label>Kích thước<select asp-for="SizeId">@foreach(var s in (List<ReferenceInput>)ViewBag.Sizes){<option value="@s.Id">@s.Name</option>}</select></label><label>Màu<select asp-for="ColorId">@foreach(var s in (List<ReferenceInput>)ViewBag.Colors){<option value="@s.Id">@s.Name</option>}</select></label><label>SKU<input asp-for="Sku" required maxlength="50"/></label><label>Giá riêng (để trống dùng giá sản phẩm)<input asp-for="Price" type="number" min="1000" max="100000000" step="1000"/></label><label class="checkbox"><input asp-for="Active"/>Đang bán</label><button class="btn-black">Lưu biến thể</button></form>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>Mã / SKU</th><th>Sản phẩm</th><th>Size / màu</th><th>Giá riêng</th><th>Tồn khả dụng</th><th></th></tr></thead><tbody>@foreach(var v in (List<Variant>)ViewBag.Variants){<tr><td>@v.Id / @v.Sku</td><td>@products.First(p=>p.Id==v.ProductId).Name</td><td>@v.Size / @v.Color</td><td>@v.Price?.ToString("N0")</td><td>@v.Stock</td><td><a href="/Admin/Variants/@v.Id">Sửa</a></td></tr>}</tbody></table></div>

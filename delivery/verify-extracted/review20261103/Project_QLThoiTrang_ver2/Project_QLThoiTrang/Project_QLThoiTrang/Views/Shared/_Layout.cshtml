@using Project_QLThoiTrang.Services
@inject StoreService Store
@{
 var settings=Store.Read(d=>d.Settings);
 var cart=SessionStore.Get<List<CartItem>>(Context.Session,"cart");
}
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · @settings.Name</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/screens.css" asp-append-version="true"/></head>
<body>
<div class="demo-strip">Bản demo · Dữ liệu lưu trên máy · Không thanh toán trực tuyến</div>
<header class="main-header">
 <div class="header-left"><a href="/" class="logo">@settings.Name</a><nav class="main-menu" aria-label="Danh mục"><a href="/Shop?category=Nữ">NỮ</a><a href="/Shop?category=Nam">NAM</a><a href="/Shop?category=Trẻ%20em">TRẺ EM</a><a href="/Shop?collection=new">HÀNG MỚI</a><a href="/Shop?collection=sale">ƯU ĐÃI</a></nav></div>
 <div class="header-right"><form action="/Shop" method="get" class="search-box"><label class="sr-only" for="header-search">Tìm sản phẩm</label><input id="header-search" type="search" name="q" placeholder="Tìm kiếm sản phẩm"/><button type="submit" aria-label="Tìm kiếm" class="search-submit"><i class="bi bi-search" aria-hidden="true"></i></button></form><a href="/Account" class="header-icon" aria-label="Tài khoản"><i class="bi bi-person" aria-hidden="true"></i></a><a href="/Shop/Wishlist" class="header-icon" aria-label="Yêu thích"><i class="bi bi-heart" aria-hidden="true"></i></a><a href="/Shop/Cart" class="header-icon cart-icon" aria-label="Giỏ hàng"><i class="bi bi-bag" aria-hidden="true"></i><span>@cart.Sum(i=>i.Quantity)</span></a></div>
</header>
<main id="main-content"><partial name="_Messages"/>@RenderBody()</main>
<footer class="footer"><div class="footer-container"><div><h3>@settings.Name</h3><p>Đơn giản, tinh tế và thoải mái mỗi ngày.</p><p>@settings.Phone<br/>@settings.Email</p></div><div><h4>HỖ TRỢ</h4><a href="/Home/Info/contact">Liên hệ</a><a href="/Home/Info/returns">Đổi trả</a><a href="/Home/Info/guide">Hướng dẫn mua hàng</a></div><div><h4>THÔNG TIN</h4><a href="/Home/Info/about">Về chúng tôi</a><a href="/Home/Info/stores">Cửa hàng</a><a href="/Home/Info/privacy">Quyền riêng tư</a><a href="/Home/Info/terms">Điều khoản</a></div><div><h4>KHÔNG GIAN CỦA BẠN</h4><a href="/Account/Orders">Đơn hàng của tôi</a><a href="/Shop/Wishlist">Sản phẩm yêu thích</a><a href="/Admin">Quản trị cửa hàng</a></div></div><div class="copyright">© @DateTime.Today.Year @settings.Name · Website demo quản lý thời trang.</div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)
</body></html>


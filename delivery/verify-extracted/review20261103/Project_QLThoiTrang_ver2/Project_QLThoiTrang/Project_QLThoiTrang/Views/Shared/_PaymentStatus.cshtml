@model Order
<section class="panel form-stack">
 <h2>Thanh toán COD</h2><p>@Model.PaymentStatus</p>
 <p>Đã thu: @Model.PaidAmount.ToString("N0") đ · Đã hoàn: @Model.RefundedAmount.ToString("N0") đ</p>
 @if((User.IsInRole("Admin")||User.IsInRole("Sales")) && Model.PaidAmount<Model.Total && new[]{"Đã xác nhận","Đang chuẩn bị","Đang giao","Đã giao","Hoàn thành"}.Contains(Model.Status)){
  <form asp-controller="Admin" asp-action="Payment" method="post" class="form-stack" data-confirm="Xác nhận đã thực nhận tiền COD?">
   <input name="id" type="hidden" value="@Model.Id"/>
   <label>Số tiền đã thực thu<input name="amount" type="number" value="@((Model.Total-Model.PaidAmount).ToString(System.Globalization.CultureInfo.InvariantCulture))" readonly/></label>
   <label>Mã biên nhận duy nhất<input name="reference" maxlength="100" required/></label>
   <p class="notice">Chỉ ghi nhận sau khi đã thu tiền hoặc đối soát đơn vị vận chuyển. Đây là sổ thu COD, không có cổng thanh toán trực tuyến.</p>
   <button class="btn-black">Xác nhận đã thu đủ COD</button>
  </form>
 }
</section>

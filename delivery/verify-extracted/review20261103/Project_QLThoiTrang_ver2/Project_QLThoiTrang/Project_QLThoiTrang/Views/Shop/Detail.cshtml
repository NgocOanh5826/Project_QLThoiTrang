@model Product
@{
	ViewData["Title"] = Model.Name;
}
<section class="page-section"><p class="breadcrumb"><a href="/">Trang chủ</a> / <a href="/Shop">Sản phẩm</a> / @Model.Name</p><div class="detail-grid"><div class="detail-image"><img src="@Model.Image" alt="@Model.Name" /></div><div class="detail-copy"><p class="eyebrow">@Model.Category · EVERYDAY ESSENTIALS</p><h1>@Model.Name</h1><p class="detail-price">@Model.Price.ToString("N0") đ</p><p class="muted">@Model.Description</p><p>Màu sắc: <strong>@Model.Color</strong></p><form asp-action="Add" method="post" class="form-stack"><input type="hidden" name="id" value="@Model.Id" /><fieldset><legend>Chọn kích cỡ / màu sắc</legend><div class="size-options" style="flex-wrap:wrap">@foreach(var v in Model.Variants.Where(v=>v.Active)){<label><input type="radio" name="variantId" value="@v.Id" checked="@(v.Id==Model.Variants.FirstOrDefault(x=>x.Active&&x.Stock>0)?.Id)" disabled="@(v.Stock==0)"/><span style="padding:8px;max-width:100%">@v.Size · @v.Color · @((v.Price??Model.Price).ToString("N0")) đ (@v.Stock)</span></label>}</div></fieldset><label>Số lượng<input type="number" name="quantity" value="1" min="1" max="@Math.Min(20, Model.AvailableStock)" disabled="@(Model.AvailableStock == 0)" /></label><button class="btn-black full-width" disabled="@(Model.AvailableStock == 0)">@(Model.AvailableStock > 0 ? "Thêm vào giỏ hàng" : "Tạm hết hàng")</button><p class="muted small">Còn @Model.AvailableStock sản phẩm · Tồn theo biến thể và kho</p></form><form asp-action="Favorite" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><button class="button-secondary">Thêm / bỏ yêu thích</button></form><details><summary>Chất liệu & chăm sóc</summary><p>Giặt nhẹ với màu tương tự. Phơi nơi thoáng mát, tránh ánh nắng trực tiếp.</p></details><details><summary>Giao hàng & đổi trả</summary><p>Phí giao hàng demo 30.000 đ; miễn phí từ 700.000 đ. <a href="/Home/Info/returns">Xem chính sách đổi trả.</a></p></details></div></div><div class="section-title related-heading"><h2>Có thể bạn cũng thích</h2><a href="/Shop">Xem thêm →</a></div><div class="product-grid">@foreach(var related in (List<Product>)ViewBag.Related){
<partial name="_ProductCard" model="related" />
}
</div></section>

<partial name="_Reviews" model="Model"/>
